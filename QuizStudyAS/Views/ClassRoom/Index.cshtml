@model QuizStudyAS.ViewModels.YourClassVM
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Lớp học";
    var searchResults = ViewBag.SearchResults as List<QuizStudyAS.ViewModels.ShowClassRoom>;
    var nameClass = ViewBag.NameClass as string;
}

<div class="container py-4 page-fade-in mx-auto" style="max-width: 1100px;">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <h2 class="fw-black text-dark m-0" style="letter-spacing: -0.5px;">Quản lý Lớp học</h2>
        
        @if (string.IsNullOrWhiteSpace(nameClass))
        {
            <button class="btn btn-primary fw-bold rounded-pill shadow-sm px-4 py-2 d-flex align-items-center gap-2 transition-smooth" data-bs-toggle="modal" data-bs-target="#createClassModal">
                <i class="bi bi-plus-lg fs-5"></i> Tạo lớp mới
            </button>
        }
    </div>

    <form asp-controller="ClassRoom" asp-action="Index" method="get" class="mb-5">
        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border border-light-subtle bg-white focus-ring-primary">
            <span class="input-group-text bg-white border-0 text-primary ps-4">
                <i class="bi bi-search"></i>
            </span>
            <input name="NameClass" type="text" class="form-control border-0 shadow-none bg-white fs-6 fw-medium text-dark"
                   placeholder="Nhập tên lớp học để tìm kiếm..." value="@nameClass" autocomplete="off">
            <button type="submit" class="btn btn-primary px-4 fw-bold">Tìm kiếm</button>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(nameClass))
    {
        <div class="mb-4">
            <a asp-action="Index" class="text-decoration-none text-muted small fw-bold mb-3 d-inline-block transition-smooth">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
            
            @if (searchResults == null || !searchResults.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light-subtle">
                    <i class="bi bi-search text-muted opacity-25" style="font-size: 4rem;"></i>
                    <h4 class="fw-bold text-dark mt-3">Không tìm thấy lớp học nào</h4>
                    <p class="text-muted">Vui lòng thử lại với một từ khóa khác.</p>
                </div>
            }
            else
            {
                <h5 class="fw-bold text-dark mb-4"><i class="bi bi-funnel text-primary me-2"></i>Tìm thấy @searchResults.Count kết quả</h5>

                <div class="d-flex flex-column gap-3">
                    @foreach (var item in searchResults)
                    {
                        <div class="card border border-light-subtle shadow-sm rounded-4 class-search-row bg-white overflow-hidden transition-smooth">
                            <div class="card-accent-left"></div>
                            <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 ms-2">
                                
                                <div>
                                    <h4 class="fw-bold text-dark mb-2">@item.ClassName</h4>
                                    <div class="d-flex flex-wrap gap-3 text-muted small fw-medium">
                                        <span><i class="bi bi-person-circle text-primary me-1"></i> Giảng viên: @item.OwnerName</span>
                                        <span><i class="bi bi-link-45deg text-success me-1"></i> Mã: @item.Link</span>
                                    </div>
                                </div>

                                <div class="text-md-end">
                                    @if (item.Status_Class == "PENDING")
                                    {
                                        <button class="btn btn-light text-secondary fw-bold rounded-pill px-4" disabled>Đang chờ duyệt</button>
                                    }
                                    else if (item.Status_Class == "APPROVED")
                                    {
                                        <a asp-controller="ClassRoom" asp-action="ClassRoomDetail" asp-route-LinkLop="@item.Link" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">
                                            Vào Lớp <i class="bi bi-arrow-right-short"></i>
                                        </a>
                                    }
                                    else if (item.OwnerName == HttpContextAccessor.HttpContext.Session.GetString("UserName"))
                                    {
                                        <button class="btn btn-primary bg-opacity-10 text-primary border-0 fw-bold rounded-pill px-4" disabled>Lớp của bạn</button>
                                    }
                                    else
                                    {
                                        <form asp-controller="ClassRoom" asp-action="Join" method="post" class="m-0">
                                            <input type="hidden" name="className" value="@item.ClassName" />
                                            <button type="submit" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">Xin Tham Gia</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="mb-5">
            <h4 class="fw-bold text-dark mb-4"><i class="bi bi-mortarboard-fill text-primary me-2"></i>Lớp học đã tham gia</h4>
            
            @if (Model.JoinedClasses.Any())
            {
                <div class="row g-4">
                    @foreach (var cls in Model.JoinedClasses)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <a asp-controller="ClassRoom" asp-action="ClassRoomDetail" asp-route-LinkLop="@cls.Link" class="text-decoration-none">
                                <div class="card h-100 border border-light-subtle shadow-sm rounded-4 class-card overflow-hidden transition-smooth bg-white">
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-3">
                                            <i class="bi bi-journal-bookmark-fill"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-4 class-title flex-grow-1">@cls.ClassName</h5>
                                        
                                        <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3">
                                            <div class="d-flex align-items-center text-muted small fw-medium text-truncate pe-2">
                                                @if (!string.IsNullOrEmpty(cls.ExistingAvatarUrl))
                                                {
                                                    <img src="@cls.ExistingAvatarUrl" alt="Avatar" class="rounded-circle me-2 object-fit-cover shadow-sm" style="width: 28px; height: 28px; border: 1px solid #e2e8f0;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle me-2 bg-secondary bg-opacity-10 text-secondary d-flex justify-content-center align-items-center" style="width: 28px; height: 28px;">
                                                        <i class="bi bi-person-fill"></i>
                                                    </div>
                                                }
                                                <span class="text-truncate">@cls.OwnerName</span>
                                            </div>
                                            <span class="badge bg-light text-secondary border fw-semibold">Thành viên</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted fst-italic">Bạn chưa tham gia lớp học nào.</p>
            }
        </div>

        <div class="mb-5">
            <h4 class="fw-bold text-dark mb-4"><i class="bi bi-award-fill text-success me-2"></i>Lớp học do bạn tạo</h4>
            
            @if (Model.MyClasses.Any())
            {
                <div class="row g-4">
                    @foreach (var cls in Model.MyClasses)
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <a asp-controller="ClassRoom" asp-action="ClassRoomDetail" asp-route-LinkLop="@cls.Link" class="text-decoration-none">
                                <div class="card h-100 border border-light-subtle shadow-sm rounded-4 class-card owner-card overflow-hidden transition-smooth bg-white">
                                    <div class="card-accent-top"></div>
                                    <div class="card-body p-4 d-flex flex-column">
                                        <div class="icon-circle bg-success bg-opacity-10 text-success mb-3">
                                            <i class="bi bi-briefcase-fill"></i>
                                        </div>
                                        <h5 class="fw-bold text-dark mb-4 class-title flex-grow-1">@cls.ClassName</h5>
                                        
                                        <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3">
                                            <div class="d-flex align-items-center text-muted small fw-medium text-truncate pe-2">
                                                @if (!string.IsNullOrEmpty(cls.ExistingAvatarUrl))
                                                {
                                                    <img src="@cls.ExistingAvatarUrl" alt="Avatar" class="rounded-circle me-2 object-fit-cover shadow-sm" style="width: 28px; height: 28px; border: 1px solid #e2e8f0;" />
                                                }
                                                else
                                                {
                                                    <div class="rounded-circle me-2 bg-success bg-opacity-10 text-success d-flex justify-content-center align-items-center" style="width: 28px; height: 28px;">
                                                        <i class="bi bi-person-fill"></i>
                                                    </div>
                                                }
                                                <span class="text-truncate">Bạn</span>
                                            </div>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 fw-semibold">Chủ phòng</span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted fst-italic">Bạn chưa tạo lớp học nào.</p>
            }
        </div>
    }
</div>

<div class="modal fade" id="createClassModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-light border-0 px-4 pt-4 pb-3">
                <h5 class="modal-title fw-bold text-dark"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Tạo lớp học mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Classroom" asp-action="CreateClassRoom" method="post">
                <div class="modal-body p-4 bg-white">
                    <label class="form-label fw-bold text-secondary small text-uppercase mb-2">Tên lớp học</label>
                    <input type="text" id="inputClassName" name="ClassName" class="form-control form-control-lg rounded-3 border-light-subtle fw-semibold fs-6" 
                           placeholder="Nhập tên lớp học của bạn..." required autocomplete="off" />
                </div>
                <div class="modal-footer border-0 px-4 pb-4 pt-0 bg-white">
                    <button type="button" class="btn btn-light fw-bold px-4 rounded-pill border" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitCreate" class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm" disabled>Xác nhận tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputName = document.getElementById('inputClassName');
            const btnSubmit = document.getElementById('btnSubmitCreate');
            const createModal = document.getElementById('createClassModal');

            // Tự động focus vào ô nhập liệu khi Modal bật lên
            if (createModal) {
                createModal.addEventListener('shown.bs.modal', function () {
                    inputName.focus();
                });
            }

            // Kiểm tra ký tự đầu vào để kích hoạt nút submit
            if (inputName && btnSubmit) {
                inputName.addEventListener('input', function () {
                    if (inputName.value.trim().length > 0) {
                        btnSubmit.disabled = false;
                    } else {
                        btnSubmit.disabled = true;
                    }
                });
            }
        });
    </script>
}