@model QuizStudyAS.ViewModels.YourClassVM
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Lớp học";
    var searchResults = ViewBag.SearchResults as List<QuizStudyAS.ViewModels.ShowClassRoom>;
    var nameClass = ViewBag.NameClass as string;
}

<form asp-controller="ClassRoom" asp-action="Index" method="get">
    <div class="container mt-4">
        <div class="input-group search-box-container">
            <span class="input-group-text bg-transparent border-0 pe-0">
                <i class="bi bi-search text-secondary"></i>
            </span>
            <input name="NameClass" type="text" class="form-control bg-transparent border-0 text-light shadow-none"
                   placeholder="Tìm kiếm lớp học..." value="@nameClass" autocomplete="off">
        </div>
    </div>
</form>

<div class="container mt-2">
    @if (!string.IsNullOrWhiteSpace(nameClass))
    {
        <div class="search-results-container">
            @if (searchResults == null || !searchResults.Any())
            {
                <div class="empty-state-box">
                    <i class="bi bi-search" style="font-size: 3rem; color: #ccc;"></i>
                    <h2>Không tìm thấy lớp học nào!</h2>
                    <p>Vui lòng thử lại với từ khóa khác.</p>
                </div>
            }
            else
            {
                <h3 class="results-header">Tìm thấy @searchResults.Count lớp học phù hợp</h3>

                <div class="class-list-rows">
                    @foreach (var item in searchResults)
                    {
                        <div class="class-row-item bg-white">
                            <div class="class-info-block">
                                <h3 class="class-title-text">@item.ClassName</h3>
                                <p class="class-meta-text">
                                    <i class="bi bi-person-circle"></i> Giảng viên: <strong>@item.OwnerName</strong>
                                </p>
                                <p class="class-meta-text class-link-style">
                                    <i class="bi bi-link-45deg"></i> Link lớp: <a href="@item.Link">@item.Link</a>
                                </p>
                            </div>

                            <div class="class-action-block">
                                @if (item.Status_Class == "PENDING")
                                {
                                    <button class="btn-action-style btn-status-pending" disabled>Đã gửi yêu cầu</button>
                                }
                                else if (item.Status_Class == "APPROVED")
                                {
                                    <a asp-controller="ClassRoom" asp-action="ClassRoomDetail" asp-route-LinkLop="@item.Link">
                                        <div class="btn-action-style btn-status-approved">Vào Lớp</div>
                                    </a>
                                }
                                else if (item.OwnerName == HttpContextAccessor.HttpContext.Session.GetString("UserName"))
                                {
                                    <button class="btn-action-style btn-status-owner" disabled>Lớp của bạn</button>
                                }
                                else
                                {
                                    <form asp-controller="ClassRoom" asp-action="Join" method="post" class="m-0">
                                        <input type="hidden" name="className" value="@item.ClassName" />
                                        <button type="submit" class="btn-action-style btn-status-join">Tham gia</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="classroom-container">
            <h2 class="section-title">Lớp học đã tham gia</h2>
            @if (Model.JoinedClasses.Any())
            {
                <div class="classroom-grid">
                    @foreach (var cls in Model.JoinedClasses)
                    {
                        <a asp-controller="ClassRoom" asp-action="ClassRoomDetail" asp-route-LinkLop="@cls.Link" style="text-decoration:none">
                            <div class="class-card-simple bg-white">
                                <h3 class="class-name-simple ">@cls.ClassName</h3>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="empty-message">Bạn chưa tham gia lớp học nào.</p>
            }

            <div class="divider-wrapper">
                <span class="divider-text">Lớp học do bạn tạo</span>
            </div>

            @if (Model.MyClasses.Any())
            {
                <div class="classroom-grid">
                    @foreach (var cls in Model.MyClasses)
                    {
                        <a asp-controller="ClassRoom" asp-action="ClassRoomDetail" asp-route-LinkLop="@cls.Link" style="text-decoration:none">
                            <div class="class-card-simple my-own-class bg-white">
                                <h3 class="class-name-simple ">@cls.ClassName</h3>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="empty-message">Bạn chưa tạo lớp học nào.</p>
            }
        </div>
    }
</div>

@if (string.IsNullOrWhiteSpace(nameClass))
{
    <div class="bottom-action-bar">
        <div class="create-class-wrapper">
            <button id="btnToggleCreate" class="btn-create-class">
                <i class="fas fa-plus"></i> Tạo lớp học mới
            </button>

            <div id="popoverCreate" class="create-popover hidden">
                <h3 class="popover-title">Tạo lớp học mới</h3>
                <form asp-controller="Classroom" asp-action="CreateClassRoom" method="post">
                    <input type="text" id="inputClassName" name="ClassName" class="popover-input" placeholder="Nhập tên lớp học..." autocomplete="off" required />
                    <button type="submit" id="btnSubmitCreate" class="popover-btn-submit">Tạo lớp</button>
                </form>
            </div>
        </div>
    </div>
}


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnToggle = document.getElementById('btnToggleCreate');
            const popover = document.getElementById('popoverCreate');
            const inputName = document.getElementById('inputClassName');
            const btnSubmit = document.getElementById('btnSubmitCreate');

            if (btnToggle && popover) {
                document.addEventListener('click', function (e) {
                    // Bấm vào nút kích hoạt mở
                    if (btnToggle.contains(e.target)) {
                        popover.classList.remove('hidden');
                        setTimeout(() => inputName.focus(), 100);
                        return;
                    }
                    // Bấm bên trong khung nội dung popup
                    if (popover.contains(e.target)) {
                        return;
                    }
                    // Bấm ra vùng trống bên ngoài
                    popover.classList.add('hidden');
                });

                // Kiểm tra ký tự đầu vào để kích hoạt nút submit
                inputName.addEventListener('input', function () {
                    if (inputName.value.trim().length > 0) {
                        btnSubmit.classList.add('active');
                    } else {
                        btnSubmit.classList.remove('active');
                    }
                });
            }
        });
    </script>
}