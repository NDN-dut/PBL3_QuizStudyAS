@model QuizStudyAS.ViewModels.ClassRoomDetailVM

@{
    ViewData["Title"] = Model.ClassName;
}

<div class="classroom-detail-container">
    
    <div class="class-header">
        <div class="header-content">
            <h1 class="class-title">@Model.ClassName</h1>
            <div class="owner-info">
                <i class="fas fa-user-circle"></i>
                <span>Giảng viên: <strong>@Model.OwnerName</strong></span>
                <span class="class-code-badge">Mã lớp: @Model.ClassCode</span>
            </div>
        </div>
        
        <div class="header-actions">
            <button id="btnOpenAddModal" class="btn-add-set">
                <i class="fas fa-plus"></i> Thêm học phần
            </button>
        </div>
    </div>

    <div class="studysets-section">
        <div class="section-header-row">
            <h3 class="section-label">Danh sách học phần (@Model.StudySets.Count)</h3>
        </div>

        @if (Model.StudySets != null && Model.StudySets.Any())
        {
            <div class="studyset-grid">
                @foreach (var set in Model.StudySets)
                {
                    <a asp-controller="StudySet" asp-action="Details" asp-route-id="@set.StudySetId" class="studyset-card">
                        <div class="set-info">
                            <h4 class="set-title">@set.Title</h4>
                        </div>
                        <div class="set-icon">
                            <i class="fas fa-clone"></i>
                        </div>
                        <button class="btn-delete-card" data-url="/ClassRoom/DeleteStudySetOfClass" data-id="@set.StudySetId" title="Xóa học phần này">
                            <i class="fas fa-times">x</i>
                        </button>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-layer-group"></i>
                <p>Chưa có học phần nào được thêm vào lớp học này.</p>
            </div>
        }
    </div>

</div>

<div id="addStudySetModal" class="custom-modal-overlay hidden">
    <div class="custom-modal-content">
        <div class="modal-header">
            <h3>Chọn Học phần vào lớp</h3>
            <button id="btnCloseModal" class="btn-close-modal">&times;</button>
        </div>

        <div class="modal-body">
            <p class="modal-subtitle">Những học phần bạn đang sở hữu:</p>

            <ul class="modal-studyset-list" id="modalStudySetList">
                <li class="modal-studyset-item loading-text">
                    Đang tải danh sách học phần...
                </li>
            </ul>
        </div>
    </div>
</div>

<style>

    .classroom-detail-container { max-width: 1000px; margin: 40px auto; padding: 0 20px; font-family: 'Segoe UI', Tahoma, sans-serif; color: #fff; }
    .class-header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #2e3856; padding-bottom: 20px; margin-bottom: 30px; }
    .class-title { font-size: 2.5rem; margin: 0 0 10px 0; color: #ffffff; }
    .owner-info { display: flex; align-items: center; gap: 10px; color: #b8bbff; }
    .class-code-badge { background: #2e3856; padding: 4px 12px; border-radius: 20px; font-size: 0.9rem; color: #fff; margin-left: 15px; }
    .studyset-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 20px; }
    .studyset-card { background: #2e3856; padding: 20px; border-radius: 12px; text-decoration: none; color: #fff; display: flex; justify-content: space-between; align-items: center; transition: transform 0.2s, background 0.2s; border: 2px solid transparent; position: relative; }
    .studyset-card:hover { transform: translateY(-5px); background: #3c476e; border-color: #7b79ff; }
    .set-title { margin: 0 0 5px 0; font-size: 1.2rem; }
    .card-count { font-size: 0.9rem; color: #939bb4; background: #1a1d3d; padding: 2px 8px; border-radius: 4px; }
    .set-icon { font-size: 1.5rem; color: #7b79ff; }
    .empty-state { text-align: center; padding: 60px; background: #1a1d3d; border-radius: 12px; color: #64748b; }
    .empty-state i { font-size: 3rem; margin-bottom: 15px; }
    .btn-add-set { background-color: #4255ff; color: white; border: none; padding: 12px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: 0.2s; }
    .btn-add-set:hover { background-color: #3144eb; }
    .btn-delete-card { position: absolute; top: 10px; right: 10px; background: transparent; border: none; color: #64748b; font-size: 1.2rem; width: 32px; height: 32px; border-radius: 50%; cursor: pointer; display: flex; justify-content: center; align-items: center; z-index: 10; transition: all 0.2s ease; }
    .btn-delete-card:hover { color: #ff4757; background-color: rgba(255, 71, 87, 0.1); transform: scale(1.1); }

    /* -------------------------------------
       CSS BỔ SUNG CHO POPUP (Đồng bộ Dark Mode)
    -------------------------------------- */
    .custom-modal-overlay {
        position: fixed; top: 0; left: 0; right: 0; bottom: 0;
        background-color: rgba(0, 0, 0, 0.7); /* Nền đen đậm hơn một chút */
        z-index: 9999;
        display: flex; justify-content: center; align-items: center;
        opacity: 1; visibility: visible; transition: all 0.2s ease;
    }
    .custom-modal-overlay.hidden { opacity: 0; visibility: hidden; }
    
    .custom-modal-content {
        background-color: #1a1d3d; /* Khớp màu với empty-state của bạn */
        width: 500px; max-width: 90%;
        border-radius: 12px;
        border: 1px solid #2e3856;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        transform: translateY(0); transition: transform 0.3s ease;
        color: #fff;
    }
    .custom-modal-overlay.hidden .custom-modal-content { transform: translateY(20px); }
    
    .modal-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid #2e3856; }
    .modal-header h3 { margin: 0; font-size: 1.25rem; color: #fff; }
    .btn-close-modal { background: none; border: none; font-size: 1.5rem; color: #64748b; cursor: pointer; transition: 0.2s; }
    .btn-close-modal:hover { color: #ff4757; }
    
    .modal-body { padding: 24px; max-height: 450px; overflow-y: auto; }
    /* Tùy chỉnh thanh cuộn cho Modal */
    .modal-body::-webkit-scrollbar { width: 8px; }
    .modal-body::-webkit-scrollbar-track { background: #1a1d3d; }
    .modal-body::-webkit-scrollbar-thumb { background: #2e3856; border-radius: 4px; }

    .modal-subtitle { margin: 0 0 16px 0; color: #b8bbff; font-size: 0.95rem; }
    .loading-text { color: #64748b; font-style: italic; text-align: center; }

    .modal-studyset-list { list-style: none; padding: 0; margin: 0; }
    .modal-studyset-item {
        display: flex; justify-content: space-between; align-items: center;
        padding: 15px; border: 1px solid #2e3856; border-radius: 8px;
        margin-bottom: 12px; background: #0a092d;
    }
    .modal-studyset-item h4 { margin: 0; font-size: 1.05rem; color: #fff; }
    
    .btn-modal-add {
        background-color: #4255ff; color: white; border: none;
        padding: 6px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; transition: 0.2s;
    }
    .btn-modal-add:hover { background-color: #3144eb; }
    .btn-modal-add:disabled { background-color: #2e3856; color: #64748b; cursor: not-allowed; }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // ==========================================
            // LOGIC XÓA HỌC PHẦN (CỦA BẠN - Đã sửa lỗi tìm cardWrapper)
            // ==========================================
            const deleteButtons = document.querySelectorAll('.btn-delete-card');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', async function (e) {
                    e.preventDefault(); 
                    e.stopPropagation(); 
                    
                    const isConfirm = confirm('Bạn có chắc chắn muốn xóa mục này khỏi lớp không?');
                    if (!isConfirm) return;

                    const url = this.getAttribute('data-url');
                    const studysetid = this.getAttribute('data-id');

                    try {
                        const formData = new FormData();
                        formData.append('studysetid', studysetid);
                        // Cần gửi thêm ClassCode hoặc ClassId để Backend biết xóa ở lớp nào
                        formData.append('classCode', '@Model.ClassCode'); 

                        const response = await fetch(url, { method: 'POST', body: formData });
                        const result = await response.json();

                        if (result.success == true) {
                            // SỬA: Tìm thẻ a (studyset-card) bọc ngoài cùng thay vì .card-link-wrapper
                            const cardWrapper = this.closest('.studyset-card'); 
                            if(cardWrapper) {
                                cardWrapper.style.opacity = '0';
                                cardWrapper.style.transform = 'scale(0.9)';
                                setTimeout(() => cardWrapper.remove(), 300);
                            }
                        } else {
                            alert('Lỗi: ' + (result.message || 'bạn không phải chủ lớp này!'));
                        }
                    } catch (error) {
                        console.error('Lỗi kết nối:', error);
                        alert('Có lỗi xảy ra khi kết nối đến máy chủ.');
                    }
                });
            });

            // ==========================================
            // LOGIC MỞ POPUP & THÊM HỌC PHẦN MỚI
            // ==========================================
            const modal = document.getElementById('addStudySetModal');
            const btnOpenModal = document.getElementById('btnOpenAddModal');
            const btnCloseModal = document.getElementById('btnCloseModal');
            const modalList = document.getElementById('modalStudySetList');
            let isLoaded = false; // Cờ kiểm tra xem đã tải data chưa

            // 1. Đóng/Mở Modal
            btnOpenModal.addEventListener('click', function () {
                modal.classList.remove('hidden');
                
                // Chỉ gọi API lấy list học phần 1 lần duy nhất để tối ưu
                if (!isLoaded) {
                    loadMyStudySets();
                }
            });

            btnCloseModal.addEventListener('click', () => modal.classList.add('hidden'));
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.add('hidden');
            });

            // 2. Hàm Fetch lấy danh sách học phần của user
            async function loadMyStudySets() {
                try {
                    // Yêu cầu bạn viết 1 API GetMyStudySetsForClass trả về JSON (Id, Title, Đã có trong lớp chưa)
                    const response = await fetch(`/StudySet/GetMyStudySetsForClass?classCode=@Model.ClassCode`);
                    const data = await response.json();
                    
                    modalList.innerHTML = ''; // Xóa chữ loading
                    
                    if (data.length === 0) {
                        modalList.innerHTML = '<li class="modal-studyset-item loading-text">Bạn chưa tạo học phần nào.</li>';
                        return;
                    }

                    data.forEach(set => {
                        // Render từng thẻ HTML. Nếu đã thêm rồi thì disable nút
                        if(set.status == "AVAILABLE"){
                            isAddedStr = 'disabled';
                            btnText = 'Đã thêm ✓' ;
                            btnStyle ='background-color: #198754; color: white;';
                        }else{
                            isAddedStr = '';
                            btnText =  'Thêm';
                            btnStyle =  '';
                        }
                        

                        const li = document.createElement('li');
                        li.className = 'modal-studyset-item';
                        li.innerHTML = `
                            <h4>${set.title}</h4>
                            <button class="btn-modal-add" data-setid="${set.studySetId}" ${isAddedStr} style="${btnStyle}">
                                ${btnText}
                            </button>
                        `;
                        modalList.appendChild(li);
                    });

                    // Gắn sự kiện click cho các nút "Thêm" vừa được tạo ra
                    attachAddEvents();
                    isLoaded = true;

                } catch (error) {
                    modalList.innerHTML = '<li class="modal-studyset-item loading-text" style="color:red">Lỗi tải dữ liệu!</li>';
                }
            }

            // 3. Hàm gắn sự kiện khi bấm nút Thêm
            function attachAddEvents() {
                const addBtns = document.querySelectorAll('.btn-modal-add:not([disabled])');
                
                addBtns.forEach(btn => {
                    btn.addEventListener('click', async function() {
                        const setId = this.getAttribute('data-setid');
                        this.disabled = true;

                        try {
                            const formData = new FormData();
                            formData.append('studySetId', setId);
                            formData.append('classCode', '@Model.ClassCode');

                            const response = await fetch('/ClassRoom/AddStudySetToClass', {
                                method: 'POST',
                                body: formData
                            });

                            const data = await response.json();
                            if (data.success == true) {
                                this.innerText = "Đã thêm ✓";
                                this.style.backgroundColor = "#198754";
                                // F5 lại trang để cập nhật danh sách bên ngoài
                                setTimeout(() => window.location.reload(), 800);
                            } else {
                                
                                alert('Bạn không phải chủ lớp này');
                                this.innerText = "Thêm";
                                this.disabled = false;
                            }
                        } catch (error) {
                            alert("Mất kết nối server!");
                            this.innerText = "Thêm";
                            this.disabled = false;
                        }
                    });
                });
            }

        });
    </script>
}