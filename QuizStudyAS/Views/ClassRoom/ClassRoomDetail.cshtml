@model QuizStudyAS.ViewModels.ClassRoomDetailVM

@{
    ViewData["Title"] = Model.ClassName;
}

<div class="container py-4 page-fade-in mx-auto" style="max-width: 1100px;">

    <div class="bg-white rounded-4 shadow-sm p-4 p-md-5 mb-5 border border-light-subtle position-relative overflow-hidden">
        <div class="card-accent-top-header"></div>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4">
            <div>
                <h1 class="fw-black text-dark mb-3" style="letter-spacing: -0.5px; font-size: 2.2rem;">@Model.ClassName</h1>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted fw-medium">
                    <span class="d-flex align-items-center bg-light px-3 py-1 rounded-pill border">
                        @if (!string.IsNullOrEmpty(Model.ExistingAvatarUrl))
                        {
                            <img src="@Model.ExistingAvatarUrl" alt="Avatar" class="rounded-circle me-2 object-fit-cover shadow-sm" style="width: 32px; height: 32px; border: 2px solid #fff;" />
                        }
                        else
                        {
                            <div class="rounded-circle me-2 bg-primary bg-opacity-10 text-primary d-flex justify-content-center align-items-center shadow-sm" style="width: 32px; height: 32px; border: 2px solid #fff;">
                                <i class="bi bi-person-fill fs-6"></i>
                            </div>
                        }
                        Giảng viên: <strong class="ms-2 text-dark">@Model.OwnerName</strong>
                    </span>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2 fs-6 shadow-xs">
                        <i class="bi bi-upc-scan me-1"></i> Mã lớp: @Model.ClassCode
                    </span>
                </div>
            </div>

            <div class="d-flex gap-3">
                <button id="btnOpenAddModal" class="btn btn-primary btn-lg fw-bold rounded-pill shadow-sm px-4 py-3 d-flex align-items-center gap-2 transition-smooth">
                    <i class="bi bi-plus-circle-fill fs-5"></i> Thêm học phần
                </button>
                <button id="btnOpenShowUserModal" class="btn btn-primary btn-lg fw-bold rounded-pill shadow-sm px-4 py-3 d-flex align-items-center gap-2 transition-smooth">
                    <i class="bi bi-people fs-5"></i> Xem thành viên
                </button>
            </div>
        </div>
        
        
        
    </div>

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold text-dark m-0">
            <i class="bi bi-journals text-primary me-2"></i>Danh sách học phần (@Model.StudySets.Count)
        </h4>
    </div>

    @if (Model.StudySets != null && Model.StudySets.Any())
    {
        <div class="row g-4">
            @foreach (var set in Model.StudySets)
            {
                <div class="col-12 col-md-6 col-lg-4 studyset-card">
                    <div class="card h-100 border border-light-subtle shadow-sm rounded-4 focus-card bg-white overflow-hidden transition-smooth position-relative">
                        <div class="card-accent-top"></div>

                        <button class="btn-delete-card shadow-sm" data-url="/ClassRoom/DeleteStudySetOfClass" data-id="@set.StudySetId" title="Xóa khỏi lớp">
                            <i class="bi bi-trash3-fill"></i>
                        </button>

                        <a href="/StudySet/Details/@set.StudySetId" class="text-decoration-none card-body p-4 d-flex flex-column">
                            <div class="icon-circle bg-primary bg-opacity-10 text-primary mb-3">
                                <i class="bi bi-journal-text"></i>
                            </div>
                            <h5 class="fw-bold text-dark mb-1 class-title">@set.Title</h5>
                            <div class="mt-auto pt-3 text-muted small fw-medium border-top border-light-subtle mt-4 d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-cursor-fill me-1"></i> Bấm để học</span>
                                <i class="bi bi-arrow-right-short fs-4 text-primary opacity-50"></i>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light-subtle mt-4">
            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-inboxes text-muted opacity-50" style="font-size: 2.5rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">Lớp học chưa có tài liệu</h4>
            <p class="text-muted mb-4">Chưa có học phần nào được thêm vào lớp học này.</p>
        </div>
    }
</div>

<div id="addStudySetModal" class="custom-modal-overlay hidden">
    <div class="custom-modal-content">
        <div class="modal-header">
            <h3><i class="bi bi-plus-square-fill text-primary me-2"></i>Thêm vào lớp</h3>
            <button id="btnCloseModal" class="btn-close-modal"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="modal-body">
            <p class="modal-subtitle">Danh sách học phần bạn đang sở hữu:</p>

            <ul class="modal-studyset-list" id="modalStudySetList">
                <li class="modal-studyset-item loading-text">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang tải danh sách...
                </li>
            </ul>
        </div>
    </div>
</div>
<div id="showUserModal" class="custom-modal-overlay hidden">
    <div class="custom-modal-content">
        <div class="modal-header">
            <h3><i class="bi bi-plus-square-fill text-primary me-2"></i>Thành viên</h3>
            <button id="btnCloseUserModal" class="btn-close-modal"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="modal-body">
            <p class="modal-subtitle">Danh sách thành viên của lớp:</p>

            <ul class="modal-studyset-list" id="modalUserList">
                <li class="modal-studyset-item loading-text">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div> Đang tải danh sách...
                </li>
            </ul>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // ==========================================
            // LOGIC XÓA HỌC PHẦN (GIỮ NGUYÊN)
            // ==========================================
            const deleteButtons = document.querySelectorAll('.btn-delete-card');
            deleteButtons.forEach(btn => {
                btn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const isConfirm = confirm('Bạn có chắc chắn muốn xóa mục này khỏi lớp không?');
                    if (!isConfirm) return;

                    const url = this.getAttribute('data-url');
                    const studysetid = this.getAttribute('data-id');

                    try {
                        const formData = new FormData();
                        formData.append('studysetid', studysetid);
                        formData.append('classCode', '@Model.ClassCode');

                        const response = await fetch(url, { method: 'POST', body: formData });
                        const result = await response.json();

                        if (result.success == true) {
                            const cardWrapper = this.closest('.studyset-card');
                            if (cardWrapper) {
                                cardWrapper.style.opacity = '0';
                                cardWrapper.style.transform = 'scale(0.9)';
                                cardWrapper.style.transition = 'all 0.3s ease';
                                setTimeout(() => cardWrapper.remove(), 300);
                            }
                        } else {
                            alert('Lỗi: ' + (result.message || 'bạn không phải chủ lớp này!'));
                        }
                    } catch (error) {
                        console.error('Lỗi kết nối:', error);
                        alert('Có lỗi xảy ra khi kết nối đến máy chủ.');
                    }
                });
            });

            // ==========================================
            // LOGIC MỞ POPUP & THÊM HỌC PHẦN MỚI (GIỮ NGUYÊN)
            // ==========================================
            const modal = document.getElementById('addStudySetModal');
            const btnOpenModal = document.getElementById('btnOpenAddModal');
            const btnCloseModal = document.getElementById('btnCloseModal');
            const modalList = document.getElementById('modalStudySetList');
            // Tìm xem cái mã CSS ngầm của trang này tên là gì (Ví dụ: nó sẽ ra chữ 'b-12345abcd')
            // Lấy từ thẻ modal có sẵn trên HTML
            let isLoadedStudySetModal = false; // Cờ kiểm tra xem đã tải data chưa
            let scopeAttribute = Array.from(modal.attributes).find(attr => attr.name.startsWith('b-'))?.name;
            // 1. Đóng/Mở Modal
            btnOpenModal.addEventListener('click', function () {
                modal.classList.remove('hidden');
                if (!isLoadedStudySetModal) {
                    loadMyStudySets();
                }
            });

            btnCloseModal.addEventListener('click', () => modal.classList.add('hidden'));
            modal.addEventListener('click', (e) => {
                if (e.target === modal) modal.classList.add('hidden');
            });

            // 2. Hàm Fetch lấy danh sách học phần của user
            async function loadMyStudySets() {
                try {
                    const response = await fetch(`/StudySet/GetMyStudySetsForClass?classCode=@Model.ClassCode`);
                    const data = await response.json();

                    modalList.innerHTML = '';

                    if (data.length === 0) {
                        modalList.innerHTML = '<li class="modal-studyset-item loading-text text-muted border-0 shadow-none bg-transparent">Bạn chưa tạo học phần nào.</li>';
                        return;
                    }

                    data.forEach(set => {
                        let isAddedStr = '';
                        let btnText = 'Thêm';
                        let btnStyle = '';

                        if (set.status == "AVAILABLE" || set.status == "Active") { // Chống lỗi cho cả DB cũ và DB mới
                            isAddedStr = 'disabled';
                            btnText = 'Đã thêm ✓';
                            btnStyle = 'background-color: #10b981; color: white; border-color: #10b981;';
                        }

                        const li = document.createElement('li');
                        li.className = 'modal-studyset-item';
                        li.innerHTML = `
                            <h4>${set.title}</h4>
                            <button class="btn-modal-add" data-setid="${set.studySetId}" ${isAddedStr} style="${btnStyle}">
                                ${btnText}
                            </button>
                        `;

                        if (scopeAttribute) {
                            li.setAttribute(scopeAttribute, '');
                            li.querySelector('h4').setAttribute(scopeAttribute, '');
                            li.querySelector('button').setAttribute(scopeAttribute, '');
                        }

                        modalList.appendChild(li);
                    });

                    attachAddEvents();
                    isLoadedStudySetModal = true;

                } catch (error) {
                    modalList.innerHTML = '<li class="modal-studyset-item loading-text text-danger border-0 shadow-none bg-transparent">Lỗi tải dữ liệu! Vui lòng thử lại.</li>';
                }
            }
            // Mở pop up xem thành viên
            const userModal = document.getElementById('showUserModal');
            const btnOpenUserModal = document.getElementById('btnOpenShowUserModal');
            const btnCloseUserModal = document.getElementById('btnCloseUserModal');
            const modalUserList = document.getElementById('modalUserList')
            let isLoadUserModal = false;
            //scopeAttribute = Array.from(userModal.attributes).find(attr => attr.name.startsWith('b-'))?.name;
            btnOpenUserModal.addEventListener("click",function(){
                userModal.classList.remove('hidden');
                if(!isLoadUserModal){
                    loadUserClass()
                }
            });
            btnCloseUserModal.addEventListener('click',function(){
                userModal.classList.add('hidden');
            });
            async function loadUserClass(){
                try{
                    
                    const response = await fetch('/ClassRoom/GetUserOfClass?classcode=@Model.ClassCode');
                    const data = await response.json();

                    modalUserList.innerHTML = '';
                    if(data.classUsers.length === 0){
                        modalUserList.innerHTML = '<li class="modal-studyset-item loading-text text-muted border-0 shadow-none bg-transparent">Không có học sinh</li>';
                        return;
                    }
                    data.classUsers.forEach(user =>{
                        const li = document.createElement('li');
                        li.className = "modal-showuser-item";
                        btnStyle = 'background-color: #E32B2B; color: white; border-color: #85291E;';
                        li.innerHTML= `
                            <h4>${user.userName}</h4>
                            <button class="btn-usermodal-del" data-userid="${user.userId}" style="${btnStyle}"  >
                                Xóa
                            </button>
                        `;
                        if (scopeAttribute) {
                            li.setAttribute(scopeAttribute, '');
                            li.querySelector('h4').setAttribute(scopeAttribute, '');
                            li.querySelector('button').setAttribute(scopeAttribute, '');
                        }
                        modalUserList.appendChild(li);
                    });
                    btnAddEventDeleteUser();
                    isLoadUserModal = true;
                }catch(error){
                     console.error("Lỗi fetch user:", error);
                     modalUserList.innerHTML = '<li class="modal-studyset-item loading-text text-danger border-0 shadow-none bg-transparent">Lỗi tải dữ liệu! Vui lòng thử lại.</li>';
                }
            }
            // Hàm gắn sự kiện khi bấm nút Thêm
            function attachAddEvents() {
                const addBtns = document.querySelectorAll('.btn-modal-add:not([disabled])');
                addBtns.forEach(btn => {
                    btn.addEventListener('click', async function () {
                        const setId = this.getAttribute('data-setid');
                        this.disabled = true;
                        this.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                        try {
                            const formData = new FormData();
                            formData.append('studySetId', setId);
                            formData.append('classCode', '@Model.ClassCode');

                            const response = await fetch('/ClassRoom/AddStudySetToClass', {
                                method: 'POST',
                                body: formData
                            });

                            const data = await response.json();
                            if (data.success == true) {
                                this.innerText = "Đã thêm ✓";
                                this.style.backgroundColor = "#10b981";
                                this.style.borderColor = "#10b981";
                                this.style.color = "white";
                                setTimeout(() => window.location.reload(), 800);
                            } else {
                                alert('Bạn không phải chủ lớp này');
                                this.innerText = "Thêm";
                                this.disabled = false;
                            }
                        } catch (error) {
                            alert("Mất kết nối server!");
                            this.innerText = "Thêm";
                            this.disabled = false;
                        }
                    });
                });
            }
            // Gắn sự kiện của button Xóa trong Show ClassUser pop-up
            function btnAddEventDeleteUser(){
                const deleteUserbtn = document.querySelectorAll('.btn-usermodal-del');
                deleteUserbtn.forEach(btn => {
                    btn.addEventListener('click', async function(){
                        const userId = this.getAttribute('data-userid');
                        try{
                            const formData = new FormData();
                            formData.append('classcode','@Model.ClassCode');
                            formData.append('userid',userId);
                            const response = await fetch ('/ClassRoom/DeleteUserOfClass',{
                                method :'POST',
                                body : formData
                            });
                            const data = await response.json();
                            if(data.success == true){
                                const liItem = this.closest('li');
                                liItem.remove();
                            }else{
                                alert("Bạn không có đủ thẩm quyền để làm việc này");
                            }

                        }catch(error){
                            alert("Xảy ra lỗi");
                            console.error("erorr:",error);
                        };
                    });
                });
            }
        });
    </script>
}