@model QuizStudyAS.ViewModels.ListRequestJoinVM

@{
    ViewData["Title"] = "Thông báo yêu cầu";
}

<div class="container py-4 page-fade-in mx-auto" style="max-width: 900px;">
    
    <div class="mb-5 d-flex align-items-center gap-3">
        <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
            <i class="bi bi-bell-fill fs-4"></i>
        </div>
        <h2 class="fw-black text-dark m-0" style="letter-spacing: -0.5px;">Thông báo yêu cầu</h2>
    </div>

    <div class="request-list-container">
        @if (Model.RequestJoinVMs == null || !Model.RequestJoinVMs.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light-subtle mt-4">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px;">
                    <i class="bi bi-check2-circle text-success opacity-50" style="font-size: 3.5rem;"></i>
                </div>
                <h4 class="fw-bold text-dark">Bạn đã xem hết thông báo!</h4>
                <p class="text-muted mb-0">Hiện tại không có yêu cầu tham gia lớp học nào đang chờ duyệt.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model.RequestJoinVMs)
                {
                    <div class="card border border-light-subtle shadow-sm rounded-4 request-row-card bg-white overflow-hidden transition-smooth position-relative">
                        <div class="card-accent-left"></div>
                        <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 ms-2">
                    
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 45px; height: 45px;">
                                    <i class="bi bi-person-fill fs-5"></i>
                                </div>
                                <div>
                                    <div class="text-dark mb-1">
                                        <span class="fw-bold fs-5">@item.UserName</span> 
                                        <span class="text-muted small ms-1">#@item.UserId</span>
                                    </div>
                                    <div class="text-muted small fw-medium">
                                        Xin tham gia lớp: <span class="text-primary fw-bold">@item.ClassName</span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 justify-content-end mt-3 mt-md-0">
                                <form asp-controller="ClassRoom" asp-action="DeniedRequest" method="post" class="ajax-action-form m-0">
                                    <input type="hidden" name="userId" value="@item.UserId" />
                                    <input type="hidden" name="classroomId" value="@item.ClassRoomId" />
                                    <button type="submit" class="btn btn-outline-danger fw-bold rounded-pill px-4 transition-smooth">Từ chối</button>
                                </form>

                                <form asp-controller="ClassRoom" asp-action="AcceptRequest" method="post" class="ajax-action-form m-0">
                                    <input type="hidden" name="userId" value="@item.UserId" />
                                    <input type="hidden" name="classroomId" value="@item.ClassRoomId" />
                                    <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm transition-smooth">Đồng ý</button>
                                </form>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    /* CSS Giao diện Focus Mode */
    body { background-color: #f6f7fb; }
    
    .request-row-card {
        border-left: none !important;
        top: 0;
    }

    .request-row-card:hover {
        top: -3px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05) !important;
        border-color: #cbd5e1 !important;
    }

    .card-accent-left {
        position: absolute;
        top: 0; left: 0; width: 4px; height: 100%;
        background: linear-gradient(180deg, #4255ff, #0ea5e9);
    }

    .transition-smooth { transition: all 0.2s ease; }
    .transition-smooth:hover { transform: translateY(-2px); }
</style>

@section Scripts {
    <script>
        const forms = document.querySelectorAll('.ajax-action-form');

        forms.forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                
                // Disable nút để tránh spam click
                const btn = this.querySelector('button[type="submit"]');
                const originalText = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                const url = this.action;
                const formData = new FormData(this);

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        const card = this.closest('.request-row-card');
                        card.style.opacity = '0';
                        card.style.transform = 'translateX(-20px)';
                        card.style.transition = 'all 0.4s ease';
                        
                        setTimeout(() => {
                            card.remove();
                            
                            // Cập nhật lại số đếm trên chuông Sidebar ngay lập tức (Nếu hàm fetchRequestCount tồn tại trong Layout)
                            if (typeof fetchRequestCount === "function") {
                                fetchRequestCount();
                            }
                            
                            // NẾU HẾT THÔNG BÁO THÌ F5 LẠI TRANG ĐỂ HIỆN EMPTY STATE
                            if(document.querySelectorAll('.request-row-card').length === 0){
                                window.location.reload();
                            }
                        }, 400);

                    } else {
                        alert('Có lỗi xảy ra, vui lòng thử lại!');
                        btn.disabled = false;
                        btn.innerHTML = originalText;
                    }
                } catch (error) {
                    console.error('Lỗi mạng:', error);
                    alert('Lỗi kết nối máy chủ!');
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            });
        });
    </script>
}