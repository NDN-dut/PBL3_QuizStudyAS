@model QuizStudyAS.ViewModels.YourClassVM

<div class="classroom-container">

    <!-- PHẦN 1: LỚP HỌC ĐÃ THAM GIA (Hiện phía trên) -->
    <h2 class="section-title">Lớp học đã tham gia</h2>
    @if (Model.JoinedClasses.Any())
    {
        <div class="classroom-grid">
            @foreach (var cls in Model.JoinedClasses)
            {
                <div class="class-card-simple">
                    <h3 class="class-name-simple">@cls.ClassName</h3>
                    
                </div>
            }
        </div>
    }
    else
    {
        <p class="empty-message">Bạn chưa tham gia lớp học nào.</p>
    }

    <!-- LABEL PHÂN CÁCH Ở GIỮA -->
    <div class="divider-wrapper">
        <span class="divider-text">Lớp học do bạn tạo</span>
    </div>

    <!-- PHẦN 2: LỚP HỌC MÌNH TẠO -->
    @if (Model.MyClasses.Any())
    {
        <div class="classroom-grid">
            @foreach (var cls in Model.MyClasses)
            {
                <div class="class-card-simple my-own-class">
                    <h3 class="class-name-simple">@cls.ClassName</h3>
                </div>
            }
        </div>
    }
    else
    {
        <p class="empty-message">Bạn chưa tạo lớp học nào.</p>
    }

</div>

<!-- NÚT TẠO LỚP HỌC (Ghim ở dưới cùng màn hình) -->
<div class="bottom-action-bar">
    
    <!-- 1. Thêm cái Wrapper bọc ngoài nút và popup -->
    <div class="create-class-wrapper">
        
        <!-- Nút gốc của bạn (Mình thêm id="btnToggleCreate" để JS gọi) -->
        <button id="btnToggleCreate" class="btn-create-class">
            <i class="fas fa-plus"></i> Tạo lớp học mới
        </button>

        <!-- 2. Khung Popup nhúng ngay bên dưới nút -->
        <div id="popoverCreate" class="create-popover hidden">
            <h3 class="popover-title">Tạo lớp học mới</h3>
            
            <form asp-controller="Classroom" asp-action="CreateClassRoom" method="post">
                <input type="text" id="inputClassName" name="ClassName" class="popover-input" placeholder="Nhập tên lớp học..." autocomplete="off" required />
                
                <button type="submit" id="btnSubmitCreate" class="popover-btn-submit">Tạo lớp</button>
            </form>
        </div>

    </div>

</div>

<style>
    /* Container bọc toàn bộ tab */
    .classroom-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 20px 100px 20px; /* Chừa 100px ở đáy để không bị nút Tạo lớp đè lên */
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Tiêu đề khu vực */
    .section-title {
        color: #333;
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    /* LƯỚI HIỂN THỊ: Ép đúng 3 cột mỗi hàng */
    .classroom-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr); /* Chia 3 phần bằng nhau */
        gap: 25px; /* Khoảng cách giữa các thẻ */
        margin-bottom: 40px;
    }

    /* Thiết kế thẻ lớp học */
    .class-card-simple {
        background-color: #ffffff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 25px 20px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
    }

        .class-card-simple:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.1);
            border-color: #0d6efd;
        }

    .class-name-simple {
        margin: 0;
        color: #2c3e50;
        font-size: 1.25rem;
        font-weight: 600;
    }

    /* Thêm màu viền nhẹ để phân biệt lớp mình tạo (Tùy chọn) */
    .my-own-class {
        border-left: 5px solid #198754;
    }

    /* LABEL PHÂN CÁCH CÓ ĐƯỜNG KẺ 2 BÊN */
    .divider-wrapper {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 40px 0;
    }

        .divider-wrapper::before,
        .divider-wrapper::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #ccc;
        }

    .divider-text {
        padding: 0 20px;
        color: #6c757d;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 1px;
    }

    .empty-message {
        color: #999;
        font-style: italic;
        margin-bottom: 30px;
    }

    /* NÚT TẠO LỚP: GHIM DƯỚI CÙNG MÀN HÌNH */
    .bottom-action-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(to top, rgba(255,255,255,1) 60%, rgba(255,255,255,0));
        padding: 20px 0 30px 0;
        text-align: center;
        pointer-events: none; /* Tránh block các click khác ở viền */
    }

    .btn-create-class {
        pointer-events: auto; /* Bật lại click cho nút */
        background-color: #0d6efd;
        color: white;
        border: none;
        padding: 12px 35px;
        font-size: 1.1rem;
        font-weight: bold;
        border-radius: 50px; /* Bo tròn hoàn toàn dạng viên thuốc */
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
        cursor: pointer;
        transition: background-color 0.3s, transform 0.2s;
    }

        .btn-create-class:hover {
            background-color: #0b5ed7;
            transform: scale(1.05);
        }

    /* Responsive: Thu về 2 cột ở iPad, 1 cột ở điện thoại */
    @@media (max-width: 900px) {
        .classroom-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @@media (max-width: 600px) {
        .classroom-grid {
            grid-template-columns: 1fr;
        }
    }
    /* Container bọc ngoài làm mỏ neo */
    .create-class-wrapper {
        position: relative;
        display: inline-block;
    }

    /* Khung Popup nhỏ */
    .create-popover {
        position: absolute;
        bottom: calc(100% + 12px); /* Đẩy khung lên phía TRÊN nút thay vì dưới */
        left: 50%; /* Căn giữa popup so với nút */
        transform: translateX(-50%) translateY(0);
        width: 300px;
        background-color: #0a092d;
        border-radius: 8px;
        padding: 16px;
        box-shadow: 0 -4px 15px rgba(0, 0, 0, 0.2); /* Đổ bóng hắt lên trên */
        border: 1px solid #2e3856;
        z-index: 1000;
        /* Hiệu ứng xuất hiện */
        opacity: 1;
        visibility: visible;
        transition: all 0.2s ease-out;
    }

        /* Trạng thái Ẩn */
    .create-popover.hidden {
            opacity: 0;
            visibility: hidden;
            transform: translateX(-50%) translateY(10px); /* Thụt xuống một chút khi ẩn */
    }

    /* Trang trí bên trong */
    .popover-title {
        color: #ffffff;
        font-size: 1.1rem;
        margin: 0 0 12px 0;
        text-align: left;
    }

    .popover-input {
        width: 100%;
        background-color: transparent;
        border: 2px solid #7b79ff;
        color: #ffffff;
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 12px;
        box-sizing: border-box;
    }

    .popover-input:focus {
            outline: none;
            border-color: #9391ff;
    }

    .popover-btn-submit {
        width: 100%;
        padding: 8px;
        border-radius: 16px;
        border: none;
        background-color: #3b415a;
        color: #8b92a5;
        font-weight: 600;
        transition: all 0.2s;
        /* 2 DÒNG NÀY LÀ KHẮC TINH CỦA LỖI NÀY */
        position: relative;
        z-index: 50; /* Đẩy nút nổi bóp lên trên cùng, xuyên qua mọi lớp đè vô hình */
        pointer-events: none; /* Trình duyệt sẽ khóa click của nút này bằng CSS */
    }

        .popover-btn-submit.active {
            background-color: #4255ff;
            color: #ffffff;
            /* MỞ KHÓA CLICK */
            pointer-events: auto;
            cursor: pointer;
        }

            .popover-btn-submit.active:hover {
                background-color: #3144eb;
            }
</style>

@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnToggle = document.getElementById('btnToggleCreate');
            const popover = document.getElementById('popoverCreate');
            const inputName = document.getElementById('inputClassName');
            const btnSubmit = document.getElementById('btnSubmitCreate');

            // 1. Bật/Tắt Popover
            btnToggle.addEventListener('click', function (e) {
                e.stopPropagation();
                popover.classList.toggle('hidden');
                
                // Focus con trỏ chuột vào ô nhập
                if (!popover.classList.contains('hidden')) {
                    setTimeout(() => inputName.focus(), 100);
                }
            });

            // 2. Click ra ngoài thì đóng
            document.addEventListener('click', function (e) {
                if (!popover.contains(e.target) && !popover.classList.contains('hidden')) {
                    popover.classList.add('hidden');
                    inputNamevalue = "";
                }
            });

            // 3. Không đóng khi click bên trong
            popover.addEventListener('click', function(e) {
                e.stopPropagation();
            });

            // 4. Validate bật nút "Tạo lớp"
            inputName.addEventListener('input', function () {
                    if (inputName.value.trim().length > 0) {
                        btnSubmit.classList.add('active'); // Thêm class này là CSS tự mở khóa click
                    } else {
                        btnSubmit.classList.remove('active'); // Xóa đi là CSS tự khóa lại
                    }
            });
        });
    </script>
}