@model QuizStudyAS.ViewModels.UserProfileVM

@{
    ViewData["Title"] = "Cài đặt tài khoản";
}

<div class="container py-5" style="max-width: 900px;">
    <form asp-action="Profile" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="ExistingAvatarUrl" />

        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    
                    <div class="position-relative d-inline-block mx-auto mb-3 avatar-wrapper cursor-pointer" title="Bấm để đổi ảnh đại diện">
                        
                        <input type="file" asp-for="AvatarFile" id="avatarInput" class="d-none" accept="image/*" />

                        <div id="avatarContainer">
                            @if (!string.IsNullOrEmpty(Model.ExistingAvatarUrl))
                            {
                                <img src="@Model.ExistingAvatarUrl" id="avatarPreview" class="rounded-circle shadow-sm border" style="width: 120px; height: 120px; object-fit: cover;" alt="Avatar" />
                            }
                            else
                            {
                                <div id="initialAvatar" class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 120px; height: 120px; font-size: 45px;">
                                    @(string.IsNullOrEmpty(Model.UserName) ? "U" : Model.UserName.Substring(0, 1).ToUpper())
                                </div>
                                <img src="" id="avatarPreview" class="rounded-circle shadow-sm border d-none" style="width: 120px; height: 120px; object-fit: cover;" alt="Avatar Preview" />
                            }
                        </div>

                        <div class="avatar-hover-overlay rounded-circle d-flex align-items-center justify-content-center">
                            <i class="bi bi-camera-fill fs-2 text-white"></i>
                        </div>
                    </div>
                    
                    <h4 class="fw-bold text-dark mb-1">@Model.UserName</h4>
                    <p class="text-muted small mb-3">@Model.Email</p>
                    <hr>
                    <div class="text-start">
                        <p class="small text-muted mb-1"><i class="bi bi-calendar3 me-2"></i> Thành viên từ: @Model.CreatedAt.ToString("yyyy")</p>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                @{
                    // Đã đổi thành cố định 1000 XP
                    int nextLevelXP = 1000;

                    // Tính phần trăm để kéo độ dài thanh Progress Bar
                    int xpPercent = (int)Math.Round((double)Model.XP / nextLevelXP * 100);
                }
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                    <h4 class="fw-bold text-dark mb-4"><i class="bi bi-controller text-primary me-2"></i>Bảng Thành Tích</h4>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-dark fs-5">🌟 Cấp độ @Model.Level</span>
                                    <span class="text-primary fw-bold">@Model.XP / @nextLevelXP XP</span>
                                </div>
                                <div class="progress" style="height: 12px; border-radius: 10px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" role="progressbar" style="width: @xpPercent%;"></div>
                                </div>
                                <p class="small text-muted m-0 mt-2">Cố gắng thêm @(nextLevelXP - Model.XP) XP nữa để thăng cấp nhé!</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-4 border d-flex align-items-center justify-content-between h-100">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="streak-flame bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="bi bi-fire fs-3"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark fs-5">Chuỗi @Model.CurrentStreak Ngày</div>
                                        <div class="small text-muted">Kỷ lục cao nhất: @Model.HighestStreak ngày</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary text-uppercase small mb-3">Huy hiệu đạt được</h6>
                    <div class="d-flex gap-3 flex-wrap">
                        <div class="badge-item text-center">
                            <div class="bg-warning bg-opacity-25 text-warning rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 border border-warning" style="width: 60px; height: 60px;">
                                <i class="bi bi-lightning-charge-fill fs-2"></i>
                            </div>
                            <span class="small fw-bold text-dark">Lần đầu<br>xung trận</span>
                        </div>

                        <div class="badge-item text-center opacity-50">
                            <div class="bg-secondary bg-opacity-10 text-secondary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 border border-secondary" style="width: 60px; height: 60px;">
                                <i class="bi bi-book-half fs-2"></i>
                            </div>
                            <span class="small fw-bold text-muted">Mọt sách<br>(Khóa)</span>
                        </div>
                    </div>
                </div>
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h4 class="fw-bold text-dark mb-4"><i class="bi bi-person-lines-fill text-primary me-2"></i>Thông tin cá nhân</h4>
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">

                    

                    <h3 class="fw-bold text-dark mb-4">Thông tin cá nhân</h3>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 mb-4" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary small">TÊN ĐĂNG NHẬP / HỌ TÊN HIỂN THỊ</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input type="text" class="form-control border-2 border-start-0 py-2" asp-for="UserName" />
                            </div>
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-secondary small">ĐỊA CHỈ EMAIL</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control border-2 border-start-0 py-2" asp-for="Email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4 pt-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold px-5 shadow-sm">
                                Lưu thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const wrapper = document.querySelector('.avatar-wrapper');
            const fileInput = document.getElementById('avatarInput');
            const imgPreview = document.getElementById('avatarPreview');
            const initialAvatar = document.getElementById('initialAvatar');

            // 1. Khi click vào khu vực avatar -> kích hoạt chọn file
            wrapper.addEventListener('click', function () {
                fileInput.click();
            });

            // 2. Xử lý khi user chọn xong file -> hiển thị xem trước (Preview)
            fileInput.addEventListener('change', function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        // Cập nhật nguồn ảnh xem trước
                        imgPreview.src = e.target.result;
                        imgPreview.classList.remove('d-none');
                        
                        // Ẩn avatar chữ cái (nếu đang hiện)
                        if (initialAvatar) {
                            initialAvatar.classList.add('d-none');
                        }
                    }
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}