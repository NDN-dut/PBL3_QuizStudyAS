@model QuizStudyAS.ViewModels.MyExamsVM

@{
    ViewData["Title"] = "Nhiệm vụ của tôi";
}

<div class="container py-4 page-fade-in mx-auto" style="max-width: 1000px;">
    <div class="mb-4 d-flex align-items-center gap-3">
        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
            <i class="bi bi-clipboard-check fs-4"></i>
        </div>
        <h2 class="fw-black text-dark m-0" style="letter-spacing: -0.5px;">Nhiệm vụ của tôi</h2>
    </div>

    <ul class="nav nav-pills mb-4 gap-2" id="examTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 fw-semibold" id="pending-tab" data-bs-toggle="pill" data-bs-target="#pending" type="button" role="tab" aria-controls="pending" aria-selected="true">
                Cần làm
                @if (Model.PendingExams.Any())
                {
                    <span class="badge bg-danger ms-1">@Model.PendingExams.Count</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 fw-semibold" id="completed-tab" data-bs-toggle="pill" data-bs-target="#completed" type="button" role="tab" aria-controls="completed" aria-selected="false">
                Đã hoàn thành
            </button>
        </li>
    </ul>

    <div class="tab-content" id="examTabsContent">

        <div class="tab-pane fade show active" id="pending" role="tabpanel" aria-labelledby="pending-tab">
            @if (!Model.PendingExams.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light-subtle">
                    <i class="bi bi-emoji-smile text-muted" style="font-size: 3.5rem;"></i>
                    <h5 class="mt-3 text-muted fw-semibold">Tuyệt vời! Bạn không có bài kiểm tra nào đang chờ.</h5>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var exam in Model.PendingExams)
                    {
                        <div class="col-12 col-md-6">
                            <div class="card h-100 border-0 shadow-sm rounded-4 grimoire-card transition-btn">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2 py-1">Lớp: @exam.ClassName</span>
                                        <span class="text-danger fw-bold small"><i class="bi bi-clock-history"></i> @exam.DurationMinutes phút</span>
                                    </div>

                                    <h5 class="card-title fw-bold text-dark mt-2 mb-3">@exam.Title</h5>

                                    <div class="mb-4 text-muted small">
                                        <div class="mb-1"><i class="bi bi-calendar-event me-1"></i> Mở: <span class="fw-medium text-dark">@exam.StartTime.ToString("HH:mm dd/MM/yyyy")</span></div>
                                        <div><i class="bi bi-calendar-x me-1"></i> Đóng: <span class="fw-medium text-dark">@exam.EndTime.ToString("HH:mm dd/MM/yyyy")</span></div>
                                    </div>

                                    <div class="mt-auto">
                                        @if (DateTime.Now >= exam.StartTime && DateTime.Now <= exam.EndTime)
                                        {
                                            <a href="/Exam/TakeExam/@exam.ExamId" class="btn btn-primary w-100 rounded-pill fw-semibold shadow-sm">
                                                <i class="bi bi-pencil-square me-1"></i> Bắt đầu làm bài
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-light w-100 rounded-pill fw-semibold text-muted border" disabled>
                                                <i class="bi bi-lock me-1"></i> Chưa đến giờ
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="completed" role="tabpanel" aria-labelledby="completed-tab">
            @if (!Model.CompletedExams.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border border-light-subtle">
                    <i class="bi bi-clipboard-x text-muted" style="font-size: 3.5rem;"></i>
                    <h5 class="mt-3 text-muted fw-semibold">Bạn chưa hoàn thành bài kiểm tra nào.</h5>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var exam in Model.CompletedExams)
                    {
                        <div class="card border-0 shadow-sm rounded-4 transition-btn">
                            <div class="card-body p-3 p-md-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill px-2 py-1">Lớp: @exam.ClassName</span>

                                        @if (exam.IsMissed)
                                        {
                                            <span class="badge bg-danger rounded-pill"><i class="bi bi-x-circle me-1"></i> Quá hạn chưa nộp</span>
                                        }
                                        else if (exam.IsLate)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill"><i class="bi bi-exclamation-triangle me-1"></i> Nộp trễ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i> Đã nộp</span>
                                        }
                                    </div>
                                    <h5 class="card-title fw-bold text-dark m-0 mb-1">@exam.Title</h5>
                                    <small class="text-muted"><i class="bi bi-calendar-check me-1"></i> Kết thúc: @exam.EndTime.ToString("HH:mm dd/MM/yyyy")</small>
                                </div>

                                <div class="text-md-end text-start border-start-md ps-md-4 mt-2 mt-md-0">
                                    <span class="text-muted small d-block mb-1">Điểm số</span>
                                    @if (!exam.IsMissed && exam.Score.HasValue)
                                    {
                                        <div class="fs-3 fw-black text-primary lh-1">@exam.Score.Value <span class="fs-6 text-muted fw-normal">/ 10</span></div>
                                    }
                                    else
                                    {
                                        <div class="fs-3 fw-black text-danger lh-1">0 <span class="fs-6 text-muted fw-normal">/ 10</span></div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>