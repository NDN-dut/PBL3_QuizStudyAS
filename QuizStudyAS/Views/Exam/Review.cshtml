@model QuizStudyAS.ViewModels.ReviewExamVM

@{
    ViewData["Title"] = "Chi tiết bài làm";
    int questionIndex = 1;
}

<div class="container py-4 page-fade-in" style="max-width: 900px;">
    <div class="card shadow-sm mb-4 border-0 rounded-4 sticky-top" style="top: 20px; z-index: 1000;">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0 text-primary fw-bold">@Model.ExamTitle</h4>
                <small class="text-muted">Học sinh: <strong>@Model.StudentName</strong></small>
            </div>
            <div class="text-end">
                <span class="fs-4 fw-black text-primary">@Model.Score<span class="fs-6 text-muted fw-normal">/10</span></span>
            </div>
        </div>
    </div>

    @foreach (var question in Model.Questions)
    {
        <div class="card mb-4 border-0 rounded-4 shadow-sm grimoire-card">
            <div class="card-body">
                <h5 class="card-title fw-bold">Câu @questionIndex: @question.Content</h5>
                <hr />
                <div class="options-container mt-3">
                    @foreach (var option in question.Options)
                    {
                        string bgClass = "";
                        string borderClass = "border";
                        string iconHtml = "";

                        if (option.IsSelected && option.IsCorrect)
                        {
                            bgClass = "bg-success bg-opacity-10";
                            borderClass = "border-success border-2";
                            iconHtml = "<i class='bi bi-check-circle-fill text-success float-end fs-5'></i>";
                        }
                        else if (option.IsSelected && !option.IsCorrect)
                        {
                            bgClass = "bg-danger bg-opacity-10";
                            borderClass = "border-danger border-2";
                            iconHtml = "<i class='bi bi-x-circle-fill text-danger float-end fs-5'></i>";
                        }
                        else if (!option.IsSelected && option.IsCorrect)
                        {
                            borderClass = "border-success border-2 border-dashed";
                            iconHtml = "<i class='bi bi-check2 text-success float-end fs-5'></i>";
                        }

                        <div class="p-3 mb-2 rounded-3 @bgClass @borderClass">
                            <div class="form-check custom-radio m-0 w-100">
                                <input class="form-check-input" type="radio" disabled checked="@option.IsSelected">
                                <label class="form-check-label w-100 opacity-100">
                                    @option.Content
                                    @Html.Raw(iconHtml)
                                </label>
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(question.Explanation))
                {
                    <div class="mt-3 p-3 bg-light border-start border-4 border-info rounded-end text-muted small">
                        <strong><i class="bi bi-lightbulb-fill text-warning me-1"></i> Giải thích:</strong> @question.Explanation
                    </div>
                }
            </div>
        </div>
        questionIndex++;
    }

    <div class="text-center mt-4 mb-5">
        <a href="javascript:history.back()" class="btn btn-secondary rounded-pill px-4 fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Quay lại bảng điểm
        </a>
    </div>
</div>