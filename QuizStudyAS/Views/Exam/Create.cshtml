@model QuizStudyAS.ViewModels.CreateExamVM

@{
    ViewData["Title"] = "Tạo bài kiểm tra mới";
}

<div class="container mt-4 mb-5 page-fade-in" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold">Tạo bài kiểm tra mới</h3>
        <div>
            <a href="/Classroom/Index" class="btn btn-light fw-bold me-2">Hủy</a>
            <button type="submit" form="createExamForm" class="btn btn-primary px-4 fw-bold">
                <i class="bi bi-cloud-arrow-up me-1"></i> Xuất bản
            </button>
        </div>
    </div>

    <form asp-action="Create" method="post" id="createExamForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ClassroomId" />

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 p-md-5">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                <div class="mb-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Tên bài kiểm tra</label>
                    <input asp-for="Title" class="form-control form-control-lg border-0 border-bottom rounded-0 fw-bold px-0 fs-4" placeholder="VD: Kiểm tra giữa kỳ - Lịch sử quân sự" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Mô tả ngắn (Tùy chọn)</label>
                    <textarea asp-for="Description" class="form-control border-0 border-bottom rounded-0 px-0" rows="1" placeholder="Nhập quy chế thi, ghi chú..."></textarea>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label class="text-muted small fw-bold text-uppercase mb-1">Thời gian mở đề</label>
                        <input asp-for="StartTime" type="datetime-local" class="form-control border-0 border-bottom rounded-0 bg-light p-2" />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase mb-1">Thời gian đóng đề</label>
                        <input asp-for="EndTime" type="datetime-local" class="form-control border-0 border-bottom rounded-0 bg-light p-2" />
                        <span asp-validation-for="EndTime" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mb-4 align-items-center">
                    <div class="col-md-6">
                        <label class="text-muted small fw-bold text-uppercase mb-1">Thời lượng làm bài (Phút)</label>
                        <input asp-for="DurationMinutes" type="number" min="1" max="300" class="form-control border-0 border-bottom rounded-0 bg-light p-2 fs-5 fw-bold text-primary" />
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="mb-3">
                    <label class="text-muted small fw-bold text-uppercase mb-2">
                        <i class="bi bi-filetype-csv me-1"></i> Ngân hàng câu hỏi (.csv)
                    </label>
                    <div class="alert alert-info border-0 bg-info bg-opacity-10 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i> File CSV phải có cấu trúc 6 cột được ngăn cách bằng dấu phẩy: <strong>Câu hỏi, Đáp án A, Đáp án B, Đáp án C, Đáp án D, Đáp án đúng (A/B/C/D), Giải thích (Tùy chọn)</strong>. (Bỏ qua dòng tiêu đề).
                    </div>
                    <input asp-for="CsvFile" type="file" accept=".csv" class="form-control border-primary shadow-sm" required />
                    <span asp-validation-for="CsvFile" class="text-danger small"></span>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}