@model IEnumerable<QuizStudyAS.Models.StudySet>

@{
    ViewData["Title"] = "Học phần của tôi";
}

<div class="container py-4" style="max-width: 1200px;">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 gap-3">
        <h2 class="fw-bold m-0 text-dark">Học phần của bạn</h2>
        <a asp-action="Create" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2 transition-btn">
            <i class="bi bi-plus-lg fs-5"></i> <span>Tạo học phần</span>
        </a>
    </div>

    <div class="position-relative mb-5 mx-auto" style="max-width: 900px;">
        <div class="input-group input-group-lg shadow-sm rounded-4 overflow-hidden bg-white border" style="transition: all 0.3s;" id="search-wrapper">
            <span class="input-group-text bg-transparent border-0 text-muted ps-4 pe-2">
                <i class="bi bi-search fs-5"></i>
            </span>
            <input type="text" id="search-input" class="form-control border-0 shadow-none bg-transparent fs-5 py-3" placeholder="Tìm kiếm học phần của bạn..." autocomplete="off">
        </div>

        <ul id="search-suggestions" class="list-group position-absolute w-100 shadow-lg mt-2 rounded-4 d-none border-0" style="z-index: 1000; max-height: 400px; overflow-y: auto;">
        </ul>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0 mt-4 mx-auto" style="max-width: 600px;">
            <i class="bi bi-journal-plus display-1 text-primary opacity-50 mb-3 d-block"></i>
            <h3 class="fw-bold text-dark">Bạn chưa có học phần nào</h3>
            <p class="text-muted fs-6 mb-4 px-4">Hãy tạo học phần đầu tiên để bắt đầu hành trình ghi nhớ từ vựng hiệu quả.</p>
            <a asp-action="Create" class="btn btn-primary btn-lg rounded-pill fw-bold px-5 shadow-sm transition-btn">
                Bắt đầu tạo ngay
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border rounded-4 shadow-sm hover-card bg-white position-relative">
                        
                        <div class="position-absolute top-0 end-0 m-3 z-3">
                            <a asp-action="Edit" asp-route-id="@item.StudySetId" class="btn btn-light btn-sm rounded-circle shadow-sm edit-btn d-flex justify-content-center align-items-center" style="width: 35px; height: 35px;" title="Sửa học phần">
                                <i class="bi bi-pencil-fill text-muted"></i>
                            </a>
                        </div>

                        <a asp-action="Details" asp-route-id="@item.StudySetId" class="text-decoration-none text-dark d-flex flex-column h-100 card-body p-4 stretched-link z-1">
                            <div class="mb-3">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-bold" style="font-size: 0.85rem;">
                                    @item.Flashcards.Count thuật ngữ
                                </span>
                            </div>
                            
                            <h4 class="card-title fw-bold mb-2 text-truncate">@item.Title</h4>
                            
                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @(string.IsNullOrEmpty(item.Description) ? "Không có mô tả" : item.Description)
                            </p>

                            <div class="mt-4 d-flex align-items-center pt-3 border-top">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2 shadow-sm" style="width: 32px; height: 32px; font-size: 14px;">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="small fw-semibold text-muted">Tạo ngày @item.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    body {
        background-color: #f6f7fb; /* Nền xám nhạt đặc trưng của Quizlet */
    }

    /* Hiệu ứng thanh tìm kiếm */
    #search-input:focus {
        outline: none;
    }

    #search-wrapper:focus-within {
        border-color: #5865f2 !important;
        box-shadow: 0 0 0 4px rgba(88, 101, 242, 0.15) !important;
    }

    /* Hiệu ứng thẻ Card */
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 2px solid transparent !important;
    }

        .hover-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,.1) !important;
            border-bottom: 2px solid #5865f2 !important; /* Viền xanh bên dưới khi hover */
        }

    /* Hiệu ứng nút bấm */
    .transition-btn {
        transition: all 0.2s;
    }

        .transition-btn:hover {
            transform: scale(1.05);
        }

    .edit-btn {
        transition: background-color 0.2s, color 0.2s;
    }

        .edit-btn:hover {
            background-color: #ffc107 !important;
        }

            .edit-btn:hover i {
                color: white !important;
            }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('search-input');
            const suggestionsBox = document.getElementById('search-suggestions');
            let debounceTimer;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const keyword = this.value.trim();

                if (keyword.length === 0) {
                    suggestionsBox.classList.add('d-none');
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch(`/StudySet/SearchSuggestions?keyword=${encodeURIComponent(keyword)}`)
                        .then(response => response.json())
                        .then(data => {
                            suggestionsBox.innerHTML = '';
                            
                            if (data.length > 0) {
                                data.forEach(item => {
                                    const li = document.createElement('li');
                                    li.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-bottom px-4';
                                    li.style.cursor = 'pointer';
                                    
                                    const highlightedTitle = highlightFuzzy(item.title, keyword);

                                    li.innerHTML = `
                                        <div class="fw-bold text-dark fs-6"><i class="bi bi-search text-muted me-3"></i>${highlightedTitle}</div>
                                        <span class="badge bg-light text-secondary rounded-pill border px-3 py-2">${item.cardCount} thẻ</span>
                                    `;
                                    
                                    li.addEventListener('click', () => {
                                        window.location.href = `/StudySet/Details/${item.id}`;
                                    });
                                    suggestionsBox.appendChild(li);
                                });
                                suggestionsBox.classList.remove('d-none');
                            } else {
                                suggestionsBox.innerHTML = '<li class="list-group-item text-muted py-4 text-center border-0 fs-6"><i>Không tìm thấy học phần nào khớp...</i></li>';
                                suggestionsBox.classList.remove('d-none');
                            }
                        });
                }, 300);
            });

            function highlightFuzzy(text, keyword) {
                const words = keyword.trim().split(/\s+/);
                let highlightedText = text;
                words.forEach(w => {
                    if (w) {
                        const regex = new RegExp(`(${w})`, 'gi');
                        highlightedText = highlightedText.replace(regex, '<span class="text-primary fw-bolder">$1</span>');
                    }
                });
                return highlightedText;
            }

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                    suggestionsBox.classList.add('d-none');
                }
            });
        });
    </script>
}