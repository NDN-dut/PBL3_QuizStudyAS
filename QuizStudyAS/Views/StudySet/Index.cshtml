@model QuizStudyAS.ViewModels.StudySetInventoryVM

@section Styles {
    <link rel="stylesheet" href="~/css/grimoire.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Học phần";
}

<div class="container py-4 page-fade-in" style="max-width: 1200px;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="inventory-icon-box shadow-sm">
                <i class="bi bi-journal-bookmark-fill text-primary"></i>
            </div>
            <h2 class="fw-black m-0 arena-title-shine text-uppercase">KHO HỌC PHẦN</h2>.
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg fw-bold px-4 py-2 rounded-pill shadow-sm d-flex align-items-center gap-2 transition-btn border-2 border-white">
            <i class="bi bi-magic fs-5"></i> <span>Tạo học phần mới</span>
        </a>
    </div>

    <div class="position-relative mb-5 mx-auto" style="max-width: 800px;">
        <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden bg-white border border-2" style="transition: all 0.3s;" id="search-wrapper">
            <span class="input-group-text bg-transparent border-0 text-muted ps-4 pe-2">
                <i class="bi bi-search fs-5"></i>
            </span>
            <input type="text" id="search-input" class="form-control border-0 shadow-none bg-transparent fs-5 py-3 fw-semibold" placeholder="Tra cứu học phần của bạn..." autocomplete="off">
        </div>
        <ul id="search-suggestions" class="list-group position-absolute w-100 shadow-lg mt-2 rounded-4 d-none border-0 overflow-hidden" style="z-index: 1000; max-height: 400px; overflow-y: auto;"></ul>
    </div>

    <div class="inventory-frame bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-5 position-relative overflow-hidden">
        <h4 class="fw-black mb-4 pb-3 border-bottom frame-title">
            <i class="bi bi-person-workspace text-primary me-2"></i> @Model.PersonalGroup.GroupName
        </h4>

        @if (!Model.PersonalGroup.StudySets.Any())
        {
            <div class="text-center py-4">
                <i class="bi bi-book-half display-4 text-primary opacity-25 empty-book-animation d-block mb-3"></i>
                <p class="text-muted fw-semibold">Kho tàng cá nhân đang trống. Hãy tạo học phần đầu tiên!</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var item in Model.PersonalGroup.StudySets)
                {
                    <div class="col">
                        <div class="card h-100 border-0 rounded-4 shadow-sm grimoire-card bg-white position-relative overflow-hidden">
                            <div class="grimoire-gradient-top"></div>
                            <i class="bi bi-journal-text position-absolute text-light opacity-50 card-watermark"></i>

                            <div class="position-absolute top-0 end-0 m-3 z-3">
                                <a asp-action="Edit" asp-route-id="@item.StudySetId" class="btn btn-light btn-sm rounded-circle shadow-sm edit-btn d-flex justify-content-center align-items-center border" style="width: 36px; height: 36px;" title="Sửa học phần">
                                    <i class="bi bi-pencil-fill text-secondary"></i>
                                </a>
                            </div>

                            <a asp-action="Details" asp-route-id="@item.StudySetId" class="text-decoration-none text-dark d-flex flex-column h-100 p-4 stretched-link z-1">
                                <div class="mb-3">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2 fw-bold shadow-xs">
                                        <i class="bi bi-stack"></i> @item.Flashcards.Count thẻ
                                    </span>
                                </div>
                                <h4 class="card-title fw-black mb-2 text-truncate pe-4" title="@item.Title">@item.Title</h4>
                                <p class="card-text text-muted small flex-grow-1 fw-semibold" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả chi tiết..." : item.Description)
                                </p>
                                <div class="mt-4 d-flex align-items-center justify-content-between pt-3 border-top position-relative">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (item.OwnerUser != null && !string.IsNullOrEmpty(item.OwnerUser.AvatarUrl))
                                        {
                                            <img src="@item.OwnerUser.AvatarUrl" class="rounded-circle border shadow-xs" style="width: 32px; height: 32px; object-fit: cover;" alt="Avatar" />
                                        }
                                        else
                                        {
                                            <div class="bg-light text-secondary rounded-circle d-flex align-items-center justify-content-center fw-bold border shadow-xs" style="width: 32px; height: 32px; font-size: 14px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                        }
                                        <span class="small fw-bold text-muted">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="play-action-icon text-primary transition-all shadow-sm bg-white rounded-circle">
                                        <i class="bi bi-play-circle-fill fs-3"></i>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @foreach (var cls in Model.ClassGroups)
    {
        <div class="inventory-frame bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-5 position-relative overflow-hidden">
            <h4 class="fw-black mb-4 pb-3 border-bottom frame-title">
                <i class="bi bi-bank text-success me-2"></i> @cls.GroupName
            </h4>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var item in cls.StudySets)
                {
                    <div class="col">
                        <div class="card h-100 border-0 rounded-4 shadow-sm grimoire-card bg-white position-relative overflow-hidden">
                            <div class="grimoire-gradient-top" style="background: linear-gradient(90deg, #10b981, #34d399);"></div>
                            <i class="bi bi-mortarboard-fill position-absolute text-light opacity-50 card-watermark"></i>

                            <a asp-action="Details" asp-route-id="@item.StudySetId" class="text-decoration-none text-dark d-flex flex-column h-100 p-4 stretched-link z-1">
                                <div class="mb-3">
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-2 fw-bold shadow-xs">
                                        <i class="bi bi-stack"></i> @item.Flashcards.Count thẻ
                                    </span>
                                </div>
                                <h4 class="card-title fw-black mb-2 text-truncate" title="@item.Title">@item.Title</h4>
                                <p class="card-text text-muted small flex-grow-1 fw-semibold" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả chi tiết..." : item.Description)
                                </p>
                                <div class="mt-4 d-flex align-items-center justify-content-between pt-3 border-top position-relative">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (item.OwnerUser != null && !string.IsNullOrEmpty(item.OwnerUser.AvatarUrl))
                                        {
                                            <img src="@item.OwnerUser.AvatarUrl" class="rounded-circle border shadow-xs" style="width: 32px; height: 32px; object-fit: cover;" alt="Avatar" />
                                        }
                                        else
                                        {
                                            <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center fw-bold border border-success border-opacity-25 shadow-xs" style="width: 32px; height: 32px; font-size: 14px;">
                                                @item.OwnerUser?.UserName.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                        <div class="d-flex flex-column lh-1">
                                            <span class="small fw-bold text-dark">@item.OwnerUser?.UserName</span>
                                            <span style="font-size: 0.7rem;" class="text-muted fw-bold mt-1">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="play-action-icon text-success transition-all shadow-sm bg-white rounded-circle">
                                        <i class="bi bi-play-circle-fill fs-3"></i>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('search-input');
            const suggestionsBox = document.getElementById('search-suggestions');
            let debounceTimer;

            searchInput.addEventListener('input', function () {
                clearTimeout(debounceTimer);
                const keyword = this.value.trim();

                if (keyword.length === 0) {
                    suggestionsBox.classList.add('d-none');
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch(`/StudySet/SearchSuggestions?keyword=${encodeURIComponent(keyword)}`)
                        .then(response => response.json())
                        .then(data => {
                            suggestionsBox.innerHTML = '';

                            if (data.length > 0) {
                                data.forEach(item => {
                                    const li = document.createElement('li');
                                    li.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 border-bottom px-4 transition-all';
                                    li.style.cursor = 'pointer';

                                    const highlightedTitle = highlightFuzzy(item.title, keyword);
                                    li.innerHTML = `
                                                <div class="fw-bold text-dark fs-6 d-flex align-items-center">
                                                    <div class="bg-primary bg-opacity-10 text-primary rounded px-2 py-1 me-3"><i class="bi bi-search"></i></div>
                                                    ${highlightedTitle}
                                                </div>
                                                <span class="badge bg-light text-primary border border-primary border-opacity-25 rounded-pill px-3 py-2 shadow-xs"><i class="bi bi-stack"></i> ${item.cardCount} thẻ</span>
                                            `;
                                    li.addEventListener('click', () => {
                                        window.location.href = `/StudySet/Details/${item.id}`;
                                    });
                                    suggestionsBox.appendChild(li);
                                });
                                suggestionsBox.classList.remove('d-none');
                            } else {
                                suggestionsBox.innerHTML = '<li class="list-group-item text-muted py-4 text-center border-0 fs-6 fw-semibold"><i>Không tìm thấy học phần nào khớp...</i></li>';
                                suggestionsBox.classList.remove('d-none');
                            }
                        });
                }, 300);
            });

            function highlightFuzzy(text, keyword) {
                const words = keyword.trim().split(/\s+/);
                let highlightedText = text;
                words.forEach(w => {
                    if (w) {
                        const regex = new RegExp(`(${w})`, 'gi');
                        highlightedText = highlightedText.replace(regex, '<span class="text-primary fw-black">$1</span>');
                    }
                });
                return highlightedText;
            }

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                    suggestionsBox.classList.add('d-none');
                }
            });
        });
    </script>
}