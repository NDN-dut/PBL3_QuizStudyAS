@model QuizStudyAS.Models.StudySet

@{
    string modeTitle = ViewBag.GameMode == "multiple" ? "Trắc nghiệm" : (ViewBag.GameMode == "written" ? "Tự luận" : "Trộn lẫn");
    ViewData["Title"] = $"Chế độ {modeTitle}: {Model.Title}";
}

<div class="focus-mode-bg py-4 py-md-5" style="min-height: calc(100vh - 70px);">
    <div class="container max-w-md mx-auto page-fade-in" style="max-width: 900px;">

        <div id="game-screen">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <a asp-action="Details" asp-route-id="@Model.StudySetId" class="text-decoration-none text-muted small fw-bold mb-2 d-inline-block transition-smooth">
                        <i class="bi bi-arrow-left me-1"></i> Thoát Game
                    </a>
                    <h3 class="fw-black m-0 text-dark" style="letter-spacing: -0.5px;">@Model.Title</h3>
                    <div class="d-flex align-items-center gap-2 mt-2">
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Chế độ: @modeTitle</span>
                        <span class="text-muted small fw-bold" id="question-counter">Câu 1 / @Model.Flashcards.Count</span>
                    </div>
                </div>
                <div class="text-end">
                    <div class="fs-4 fw-black text-primary mb-2" id="score-display">Điểm: 0</div>
                    <div class="badge bg-danger fs-5 px-3 py-2 shadow-sm @(ViewBag.GameTimer == 0 ? "d-none" : "")" id="timer-badge">
                        <i class="bi bi-stopwatch me-1"></i> <span id="time-left">@ViewBag.GameTimer</span>s
                    </div>
                </div>
            </div>

            <div class="progress mb-4 shadow-sm bg-white border" style="height: 8px; border-radius: 10px;">
                <div id="progress-bar" class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%; transition: width 0.4s ease;"></div>
            </div>

            <div class="card shadow-focus border-0 border-light-subtle rounded-4 mb-4 bg-white">
                <div class="card-body p-4 p-md-5 text-center d-flex flex-column align-items-center justify-content-center" style="min-height: 220px;">
                    <span class="text-muted small text-uppercase fw-bold mb-3" style="letter-spacing: 1px;" id="question-type-hint">Chế độ: Chọn đáp án đúng</span>
                    <h2 class="fw-bold mb-0 text-dark display-6" id="question-text">Đang tải...</h2>
                </div>
            </div>

            <div id="interaction-area">
            </div>
        </div>

        <div id="result-screen" class="text-center py-5 d-none bg-white rounded-4 shadow-focus border mt-4">
            <h1 class="display-1 mb-3">🏆</h1>
            <h2 class="fw-black text-dark mb-2">Trận đấu kết thúc!</h2>
            <p class="text-muted fs-5 mb-4">Bạn đã hoàn thành xuất sắc thử thách học phần này.</p>

            <div class="row justify-content-center mb-4">
                <div class="col-md-5">
                    <div class="card border-primary border-opacity-50 bg-primary bg-opacity-10 rounded-4 shadow-sm">
                        <div class="card-body py-4">
                            <h1 class="display-3 text-primary fw-black m-0" id="final-score">0</h1>
                            <p class="text-primary fw-bold text-uppercase m-0 mt-2 small">Tổng Điểm XP Đạt Được</p>
                        </div>
                    </div>
                </div>
            </div>

            <div id="gamification-reward-quiz" class="mb-5 bg-light p-3 rounded-4 d-inline-block border mx-auto" style="min-width: 300px;">
                <div class="spinner-border spinner-border-sm text-primary"></div>
                <span class="text-primary fw-bold ms-2">Đang tính toán phần thưởng...</span>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                <button class="btn btn-primary btn-lg fw-bold px-5 rounded-pill shadow-sm transition-smooth" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise me-1"></i> Đấu Lại
                </button>
                <a asp-action="Details" asp-route-id="@Model.StudySetId" class="btn btn-light btn-lg px-5 fw-bold border rounded-pill shadow-sm text-secondary transition-smooth">
                    Trở Về Học Phần
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    <style >
        /* Nền tối giản */
        .focus-mode-bg {
            background-color: #f8fafc;
            margin: -1.5rem;
            padding: 1.5rem;
        }

        /* Đổ bóng trung tâm */
        .shadow-focus {
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.05);
        }

        /* HIỆU ỨNG TƯƠNG TÁC CHO NÚT ĐÁP ÁN (TRẮC NGHIỆM) */
        .btn-quiz-option {
            border: 2px solid #e2e8f0;
            color: #475569;
            border-radius: 1rem;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            text-align: left;
            white-space: normal;
            word-wrap: break-word;
        }

            .btn-quiz-option:hover:not(:disabled) {
                border-color: #4255ff;
                background-color: #f0f9ff !important;
                color: #1e293b;
                transform: translateY(-3px);
                box-shadow: 0 10px 20px rgba(66, 85, 255, 0.1);
            }

                .btn-quiz-option:hover:not(:disabled) .qz-badge {
                    background-color: #4255ff !important;
                    color: #ffffff !important;
                    border-color: #4255ff !important;
                }

        /* ==================================================== */
        /* TRẠNG THÁI ĐÚNG / SAI MẠNH MẼ (KHÔNG THỂ BỊ GHI ĐÈ) */
        /* ==================================================== */
        .qz-correct {
            background-color: #10b981 !important;
            border-color: #10b981 !important;
            color: #ffffff !important;
            box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2) !important;
        }

            .qz-correct .qz-badge, .qz-correct .opt-text {
                background-color: transparent !important;
                color: #ffffff !important;
                border-color: #ffffff !important;
            }

        .qz-wrong {
            background-color: #ef4444 !important;
            border-color: #ef4444 !important;
            color: #ffffff !important;
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.2) !important;
        }

            .qz-wrong .qz-badge, .qz-wrong .opt-text {
                background-color: transparent !important;
                color: #ffffff !important;
                border-color: #ffffff !important;
            }

        /* Animation khi Load câu hỏi mới */
        .fade-in-up {
            animation: fadeInUp 0.4s ease-out forwards;
        }
        @@keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Animation Rung lắc khi chọn Sai */
        .shake-anim {
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
            transform: translate3d(0, 0, 0);
            backface-visibility: hidden;
            perspective: 1000px;
        }
        @@keyframes shake {
            10%, 90% {
                transform: translate3d(-1px, 0, 0);
            }

            20%, 80% {
                transform: translate3d(2px, 0, 0);
            }

            30%, 50%, 70% {
                transform: translate3d(-4px, 0, 0);
            }

            40%, 60% {
                transform: translate3d(4px, 0, 0);
            }
        }

        /* Animation nháy đỏ cảnh báo hết giờ */
        .timer-warning {
            animation: pulse-red 1s infinite;
        }
        @@keyframes pulse-red {
            0% {
                transform: scale(1);
                background-color: #dc3545;
            }

            50% {
                transform: scale(1.1);
                background-color: #bb2d3b;
                box-shadow: 0 0 15px rgba(220, 53, 69, 0.5);
            }

            100% {
                transform: scale(1);
                background-color: #dc3545;
            }
        }

        /* Chuyển động mượt mà cho các liên kết */
        .transition-smooth {
            transition: all 0.3s ease;
        }

            .transition-smooth:hover {
                transform: translateY(-2px);
            }
</style>
</style>
@section Scripts {
    <script>
        const configMode = "@ViewBag.GameMode";
        const configTimer = parseInt("@ViewBag.GameTimer");
        const hasTimer = configTimer > 0;

        const deck = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Flashcards.Select(f => new { term = f.Term, def = f.Definition })));
        deck.sort(() => Math.random() - 0.5); // Trộn ngẫu nhiên câu hỏi

        let currentIndex = 0;
        let score = 0;
        let currentTimer = null;
        let timeLeft = configTimer;

        const uiQuestion = document.getElementById('question-text');
        const uiHint = document.getElementById('question-type-hint');
        const uiArea = document.getElementById('interaction-area');
        const uiProgress = document.getElementById('progress-bar');
        const uiCounter = document.getElementById('question-counter');
        const uiScore = document.getElementById('score-display');
        const uiTimeLeft = document.getElementById('time-left');
        const uiTimerBadge = document.getElementById('timer-badge');

        document.addEventListener('DOMContentLoaded', loadQuestion);

        function loadQuestion() {
            if (currentIndex >= deck.length) {
                endGame();
                return;
            }

            const currentQ = deck[currentIndex];

            // Xóa animation cũ để chuẩn bị câu mới
            uiArea.classList.remove('fade-in-up');
            void uiArea.offsetWidth;
            uiArea.classList.add('fade-in-up');

            uiQuestion.innerText = currentQ.term;
            uiCounter.innerText = `Câu ${currentIndex + 1} / ${deck.length}`;
            uiProgress.style.width = `${(currentIndex / deck.length) * 100}%`;
            uiArea.innerHTML = ''; // Clear vùng tương tác

            let activeType = "multiple";
            if (configMode === "written") {
                activeType = "written";
            } else if (configMode === "mixed") {
                activeType = Math.random() > 0.5 ? "multiple" : "written";
            }

            if (activeType === "multiple") {
                // GIAO DIỆN TRẮC NGHIỆM
                uiHint.innerText = "CHẾ ĐỘ: CHỌN ĐÁP ÁN ĐÚNG";
                let options = [currentQ.def];
                let wrongPool = deck.filter(f => f.def !== currentQ.def);
                wrongPool.sort(() => Math.random() - 0.5);

                for (let i = 0; i < 3; i++) {
                    if (wrongPool[i]) options.push(wrongPool[i].def);
                }
                options.sort(() => Math.random() - 0.5); // Trộn 4 đáp án

                const row = document.createElement('div');
                row.className = 'row g-3';

                options.forEach((opt, idx) => {
                    const col = document.createElement('div');
                    col.className = 'col-md-6';

                    const btn = document.createElement('button');
                    btn.className = 'btn btn-quiz-option w-100 p-4 fs-5 fw-semibold d-flex align-items-center bg-white';

                    // GẮN CHUẨN ĐÁP ÁN VÀO THUỘC TÍNH ẨN ĐỂ KIỂM TRA CHÍNH XÁC
                    btn.dataset.answer = opt;

                    const letter = String.fromCharCode(65 + idx);
                    btn.innerHTML = `<span class="badge bg-light text-secondary border qz-badge me-3 fs-6">${letter}</span> <span class="opt-text">${opt}</span>`;

                    btn.onclick = () => submitAnswer(opt, currentQ.def, btn, "multiple");
                    col.appendChild(btn);
                    row.appendChild(col);
                });
                uiArea.appendChild(row);

            } else {
                // GIAO DIỆN TỰ LUẬN
                uiHint.innerText = "CHẾ ĐỘ: GÕ NGHĨA CỦA TỪ BẰNG TIẾNG VIỆT";
                uiArea.innerHTML = `
                            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                                <div class="d-flex flex-column flex-md-row gap-3">
                                    <input type="text" id="written-input" class="form-control form-control-lg p-4 fs-5 fw-bold text-center border-2 rounded-4" placeholder="Nhập định nghĩa của thuật ngữ này..." autocomplete="off">
                                    <button class="btn btn-primary px-5 fw-bold rounded-4 shadow-sm fs-5" id="btn-submit-written" style="min-width: 140px;">
                                        GỬI <i class="bi bi-send-fill ms-2"></i>
                                    </button>
                                </div>
                            </div>
                        `;
                const txtInput = document.getElementById('written-input');
                const btnSubmit = document.getElementById('btn-submit-written');

                setTimeout(() => txtInput.focus(), 150);

                txtInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') btnSubmit.click();
                });
                btnSubmit.onclick = () => submitAnswer(txtInput.value, currentQ.def, txtInput, "written");
            }

            startTimer();
        }

        // HÀM CHẤM ĐIỂM VÀ ĐỔI MÀU GIAO DIỆN ĐÃ ĐƯỢC FIX LỖI
        function submitAnswer(userAnswer, correctAnswer, element, modeType) {
            stopTimer();
            // Chuẩn hóa chuỗi (Bỏ khoảng trắng 2 đầu, đưa về chữ thường)
            const isCorrect = (userAnswer || "").trim().toLowerCase() === (correctAnswer || "").trim().toLowerCase();

            if (modeType === "multiple") {
                const btns = document.querySelectorAll('.btn-quiz-option');
                btns.forEach(b => b.disabled = true); // Khóa toàn bộ nút

                if (isCorrect) {
                    element.classList.remove('bg-white', 'text-dark'); // Xóa nền trắng
                    element.classList.add('qz-correct'); // Nhuộm Xanh
                    calculateScore();
                } else {
                    if (element) {
                        element.classList.remove('bg-white', 'text-dark'); // Xóa nền trắng
                        element.classList.add('qz-wrong', 'shake-anim'); // Nhuộm Đỏ và Rung lắc
                    }
                    // Tự động tìm đáp án đúng để hiện màu Xanh cho người dùng biết
                    btns.forEach(b => {
                        if (b.dataset.answer.trim().toLowerCase() === correctAnswer.trim().toLowerCase()) {
                            b.classList.remove('bg-white', 'text-dark');
                            b.classList.add('qz-correct');
                        }
                    });
                }
            } else {
                element.disabled = true;
                document.getElementById('btn-submit-written').disabled = true;

                if (isCorrect) {
                    element.classList.remove('bg-white', 'text-dark');
                    element.classList.add('qz-correct');
                    calculateScore();
                } else {
                    element.classList.remove('bg-white', 'text-dark');
                    element.classList.add('qz-wrong', 'shake-anim');
                    element.value = `Sai! Đáp án đúng: ${correctAnswer}`;
                }
            }

            setTimeout(() => {
                currentIndex++;
                loadQuestion();
            }, 1800); // Tăng thời gian chờ lên 1.8 giây để người học kịp nhìn đáp án
        }

        function calculateScore() {
            score += 100 + (hasTimer ? (timeLeft * 10) : 0);
            uiScore.innerText = `Điểm: ${score}`;
        }

        // LOGIC THỜI GIAN
        function startTimer() {
            if (!hasTimer) return;
            timeLeft = configTimer;
            uiTimeLeft.innerText = timeLeft;
            uiTimerBadge.classList.remove('timer-warning');

            currentTimer = setInterval(() => {
                timeLeft--;
                uiTimeLeft.innerText = timeLeft;

                if (timeLeft <= 5) uiTimerBadge.classList.add('timer-warning');

                if (timeLeft <= 0) {
                    stopTimer();
                    const activeInput = document.getElementById('written-input');
                    submitAnswer("!!!TIMEOUT!!!", deck[currentIndex].def, activeInput || null, activeInput ? "written" : "multiple");
                }
            }, 1000);
        }

        function stopTimer() {
            if (currentTimer) clearInterval(currentTimer);
        }

        // KẾT THÚC GAME VÀ LƯU KẾT QUẢ API
        function endGame() {
            document.getElementById('game-screen').classList.add('d-none');
            document.getElementById('result-screen').classList.remove('d-none');
            document.getElementById('final-score').innerText = score;

            fetch('/StudySet/SaveProgress', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ StudySetId: @Model.StudySetId, ActionType: "Quiz", Score: score })
            })
                .then(res => res.json())
                .then(res => {
                    const rewardBox = document.getElementById('gamification-reward-quiz');
                    if (res.success) {
                        let navLevel = document.getElementById('nav-user-level');
                        let navStreak = document.getElementById('nav-user-streak');
                        if (navLevel) navLevel.innerText = res.level;
                        if (navStreak) navStreak.innerText = res.currentStreak;

                        if (rewardBox) {
                            let msg = `<div class="fs-4 fw-bold text-primary mb-1"><i class="bi bi-star-fill text-warning"></i> Thưởng +${res.earnedXP} XP</div>`;
                            if (res.isStreakSaved) {
                                msg += `<div class="text-danger fw-bold fs-5 mt-1"><i class="bi bi-fire"></i> Chuỗi ${res.currentStreak} ngày!</div>`;
                            }
                            if (res.isLeveledUp) {
                                msg += `<div class="text-success fw-bold fs-4 mt-2 bg-success bg-opacity-10 p-2 rounded-3">🌟 BẠN ĐÃ LÊN CẤP ${res.level}! 🌟</div>`;
                                triggerConfetti();
                            }
                            rewardBox.innerHTML = msg;
                            rewardBox.className = "mb-5 text-center";
                        }
                    } else {
                        if (rewardBox) rewardBox.style.display = 'none';
                    }
                })
                .catch(() => {
                    const rewardBox = document.getElementById('gamification-reward-quiz');
                    if (rewardBox) rewardBox.style.display = 'none';
                });
        }

        function triggerConfetti() {
            var duration = 3 * 1000;
            var end = Date.now() + duration;
            (function frame() {
                confetti({ particleCount: 5, angle: 60, spread: 55, origin: { x: 0 } });
                confetti({ particleCount: 5, angle: 120, spread: 55, origin: { x: 1 } });
                if (Date.now() < end) requestAnimationFrame(frame);
            }());
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
}