@model QuizStudyAS.DTOs.PaginatedList<QuizStudyAS.Models.Classroom>

@{
    ViewData["Title"] = "Quản lý Lớp học";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold">Danh sách Lớp học</h2>
    </div>

    <form method="get" asp-action="ManageClassrooms" class="mb-4 bg-light p-3 rounded border shadow-sm">
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                       class="form-control" placeholder="Tìm theo tên hoặc mã tham gia..." />
            </div>
            <div class="col-md-4">
                <input type="text" name="ownerName" value="@ViewBag.CurrentOwnerName"
                       class="form-control" placeholder="Tìm theo tên người tạo..." />
            </div>
            <div class="col-md-4">
                <select name="statusId" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="1" selected="@(ViewBag.CurrentStatusId == 1 ? "selected" : null)">Hoạt động</option>
                    <option value="2" selected="@(ViewBag.CurrentStatusId == 2 ? "selected" : null)">Đã xóa</option>
                    <option value="3" selected="@(ViewBag.CurrentStatusId == 3 ? "selected" : null)">Bị khóa</option>
                </select>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">Từ ngày</span>
                    <input type="date" name="fromDate" value="@ViewBag.CurrentFromDate" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">Đến ngày</span>
                    <input type="date" name="toDate" value="@ViewBag.CurrentToDate" class="form-control" />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50 fw-bold"><i class="bi bi-search me-1"></i> Lọc</button>
                <a asp-action="ManageClassrooms" class="btn btn-outline-secondary w-50 fw-bold"><i class="bi bi-arrow-counterclockwise me-1"></i> Xóa lọc</a>
            </div>
        </div>
    </form>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tên Lớp</th>
                    <th>Mã tham gia</th>
                    <th>Người tạo</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var cls in Model.Items)
                    {
                        <tr>
                            <td>@cls.ClassroomId</td>
                            <td class="fw-bold">@cls.ClassName</td>
                            <td>@cls.InviteCode</td>
                            <td>@(cls.OwnerUser?.UserName ?? "N/A")</td>

                            <td>@cls.CreatedAt.ToString("dd/MM/yyyy")</td>

                            <td>
                                @if (cls.StatusId == (int)QuizStudyAS.Models.ClassroomStatusEnum.Active)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else if (cls.StatusId == (int)QuizStudyAS.Models.ClassroomStatusEnum.LockedByAdmin)
                                {
                                    <span class="badge bg-danger">Bị khóa</span>
                                }
                                else if (cls.StatusId == (int)QuizStudyAS.Models.ClassroomStatusEnum.DeletedByUser)
                                {
                                    <span class="badge bg-warning text-dark">Đã xóa</span>
                                }
                            </td>
                            <td class="text-center">
                                @{
                                    bool isCurrentlyActive = cls.StatusId == (int)QuizStudyAS.Models.ClassroomStatusEnum.Active;
                                    bool isDeleted = cls.StatusId == (int)QuizStudyAS.Models.ClassroomStatusEnum.DeletedByUser;
                                }
                                <button class="btn btn-sm @(isCurrentlyActive ? "btn-outline-danger" : "btn-outline-success")"
                                        @(isDeleted ? "disabled title='Không thể thao tác trên lớp học đã bị xóa'" : "")
                                        onclick="toggleClassroomStatus(@cls.ClassroomId, @(isCurrentlyActive.ToString().ToLower()))">
                                    @(isCurrentlyActive ? "Khóa lớp" : "Mở khóa")
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Không tìm thấy lớp học nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div> <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="ManageClassrooms"
                   asp-route-pageIndex="@(Model.PageIndex - 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-ownerName="@ViewBag.CurrentOwnerName"
                   asp-route-statusId="@ViewBag.CurrentStatusId"
                   asp-route-fromDate="@ViewBag.CurrentFromDate"
                   asp-route-toDate="@ViewBag.CurrentToDate">Trước</a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="ManageClassrooms"
                       asp-route-pageIndex="@i"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-ownerName="@ViewBag.CurrentOwnerName"
                       asp-route-statusId="@ViewBag.CurrentStatusId"
                       asp-route-fromDate="@ViewBag.CurrentFromDate"
                       asp-route-toDate="@ViewBag.CurrentToDate">@i</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="ManageClassrooms"
                   asp-route-pageIndex="@(Model.PageIndex + 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-ownerName="@ViewBag.CurrentOwnerName"
                   asp-route-statusId="@ViewBag.CurrentStatusId"
                   asp-route-fromDate="@ViewBag.CurrentFromDate"
                   asp-route-toDate="@ViewBag.CurrentToDate">Sau</a>
            </li>
        </ul>
</nav>

@section Scripts {
    <script>
        async function toggleClassroomStatus(id, currentStatus) {
            const action = currentStatus ? "KHÓA" : "MỞ KHÓA";
            if (confirm(`Bạn có khá chắc chắn muốn ${action} lớp học này không?`)) {
                const formData = new FormData();
                formData.append('id', id);

                try {
                    const response = await fetch('/Admin/ToggleClassroomStatus', { method: 'POST', body: formData });
                    if (!response.ok) throw new Error("Lỗi kết nối tới máy chủ.");

                    const result = await response.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert("Lỗi xử lý: " + error.message);
                }
            }
        }
    </script>
}