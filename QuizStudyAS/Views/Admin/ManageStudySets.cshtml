@model QuizStudyAS.DTOs.PaginatedList<QuizStudyAS.Models.StudySet>

@{
    ViewData["Title"] = "Quản lý Học phần";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold">Danh sách Học phần</h2>
    </div>

    <form method="get" asp-action="ManageStudySets" class="mb-4 bg-light p-3 rounded border shadow-sm">
        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <input type="text" name="searchString" value="@ViewBag.CurrentSearch"
                       class="form-control" placeholder="Tìm theo tiêu đề học phần..." />
            </div>
            <div class="col-md-4">
                <input type="text" name="ownerName" value="@ViewBag.CurrentOwnerName"
                       class="form-control" placeholder="Tìm theo tên người tạo..." />
            </div>
            <div class="col-md-4">
                <select name="statusId" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="1" selected="@(ViewBag.CurrentStatusId == 1 ? "selected" : null)">Hoạt động</option>
                    <option value="2" selected="@(ViewBag.CurrentStatusId == 2 ? "selected" : null)">Đã xóa</option>
                    <option value="3" selected="@(ViewBag.CurrentStatusId == 3 ? "selected" : null)">Bị khóa</option>
                </select>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">Từ ngày</span>
                    <input type="date" name="fromDate" value="@ViewBag.CurrentFromDate" class="form-control" />
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">Đến ngày</span>
                    <input type="date" name="toDate" value="@ViewBag.CurrentToDate" class="form-control" />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50 fw-bold"><i class="bi bi-search me-1"></i> Lọc</button>
                <a asp-action="ManageStudySets" class="btn btn-outline-secondary w-50 fw-bold"><i class="bi bi-arrow-counterclockwise me-1"></i> Xóa lọc</a>
            </div>
        </div>
    </form>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tiêu đề</th>
                    <th>Người tạo</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Items.Any())
                {
                    foreach (var set in Model.Items)
                    {
                        <tr>
                            <td>@set.StudySetId</td>

                            <td><span class="fw-bold text-dark">@set.Title</span></td>

                            <td>@set.OwnerUser?.UserName</td>

                            <td>@set.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>
                                @if (set.StatusId == (int)QuizStudyAS.Models.StudySetStatusEnum.Active)
                                {
                                    <span class="badge bg-success">Hoạt động</span>
                                }
                                else if (set.StatusId == (int)QuizStudyAS.Models.StudySetStatusEnum.LockedByAdmin)
                                {
                                    <span class="badge bg-danger">Bị khóa</span>
                                }
                                else if (set.StatusId == (int)QuizStudyAS.Models.StudySetStatusEnum.DeletedByUser)
                                {
                                    <span class="badge bg-warning text-dark">Đã xóa</span>
                                }
                            </td>

                            <td class="text-center">
                                @{
                                    bool isCurrentlyActive = set.StatusId == (int)QuizStudyAS.Models.StudySetStatusEnum.Active;
                                    bool isDeleted = set.StatusId == (int)QuizStudyAS.Models.StudySetStatusEnum.DeletedByUser;
                                }
                                <button class="btn btn-sm @(isCurrentlyActive ? "btn-outline-danger" : "btn-outline-success")"
                                        @(isDeleted ? "disabled title='Không thể thao tác trên học phần đã bị người dùng xóa'" : "")
                                        onclick="toggleStudySetStatus(@set.StudySetId, @(isCurrentlyActive.ToString().ToLower()))">
                                    @(isCurrentlyActive ? "Khóa học phần" : "Mở khóa")
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Không tìm thấy học phần nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> <nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
            <a class="page-link" asp-action="ManageStudySets"
               asp-route-pageIndex="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewBag.CurrentSearch"
               asp-route-ownerName="@ViewBag.CurrentOwnerName"
               @* asp-route-isActive="@ViewBag.CurrentIsActive" *@
               asp-route-statusId="@ViewBag.CurrentStatusId"
               asp-route-fromDate="@ViewBag.CurrentFromDate"
               asp-route-toDate="@ViewBag.CurrentToDate">Trước</a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="ManageStudySets"
                   asp-route-pageIndex="@i"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-ownerName="@ViewBag.CurrentOwnerName"
                   asp-route-isActive="@ViewBag.CurrentIsActive"
                   asp-route-fromDate="@ViewBag.CurrentFromDate"
                   asp-route-toDate="@ViewBag.CurrentToDate">@i</a>
            </li>
        }

        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
            <a class="page-link" asp-action="ManageStudySets"
               asp-route-pageIndex="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewBag.CurrentSearch"
               asp-route-ownerName="@ViewBag.CurrentOwnerName"
               asp-route-isActive="@ViewBag.CurrentIsActive"
               asp-route-fromDate="@ViewBag.CurrentFromDate"
               asp-route-toDate="@ViewBag.CurrentToDate">Sau</a>
        </li>
    </ul>
</nav>

@section Scripts {
    <script>
        async function toggleStudySetStatus(id, currentStatus) {
            const action = currentStatus ? "KHÓA" : "MỞ KHÓA";
            if (confirm(`Bạn có hầu như chắc chắn muốn ${action} học phần này không?`)) {
                const formData = new FormData();
                formData.append('id', id);

                try {
                    const response = await fetch('/Admin/ToggleStudySetStatus', { method: 'POST', body: formData });
                    if (!response.ok) throw new Error("Lỗi kết nối tới máy chủ.");

                    const result = await response.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    alert("Lỗi xử lý: " + error.message);
                }
            }
        }
    </script>
}