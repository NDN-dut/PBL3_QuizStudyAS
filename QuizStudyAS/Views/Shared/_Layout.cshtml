@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizStudyAS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/QuizStudyAS.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Views/Shared/_Layout.cshtml.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    <script>
            // 1. Phủ màu tối ngay lập tức vào thẻ gốc <html>
            if (localStorage.getItem('quiz_study_theme') === 'dark') {
                document.documentElement.classList.add('dark-theme');
            }
            // 2. Mở rộng Sidebar ngay lập tức bằng cách dán nhãn lên thẻ <html>
            if (localStorage.getItem('quiz_study_sidebar_state') === 'true') {
                document.documentElement.classList.add('sidebar-expanded-state');
            }
    </script>
</head>
<body>
    <script>
            if (localStorage.getItem('quiz_study_theme') === 'dark') {
                document.body.classList.add('dark-theme');
            }
    </script>
    @{
        // ĐỌC THÔNG TIN TỪ SESSION (Chuẩn theo code cũ của nhóm)
        var currentUserName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
        var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
        var userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");
        
        // Biến kiểm tra trạng thái đăng nhập
        bool isLoggedIn = !string.IsNullOrEmpty(currentUserName);
    }

    <header class="top-navbar bg-white border-bottom shadow-sm d-flex align-items-center justify-content-between px-3">
        <div class="d-flex align-items-center">
            <button class="btn btn-light border-0 shadow-none p-2 fs-4 me-3" id="btn-toggle-sidebar">
                <i class="bi bi-list"></i>
            </button>
            <a class="navbar-brand fw-bold text-primary fs-3 m-0" asp-controller="Home" asp-action="Index">
                QuizStudyAS
            </a>
        </div>

        <div class="user-info-section d-flex align-items-center">
            @if (isLoggedIn)
            {
                <div class="dropdown">
                    <div class="d-flex align-items-center cursor-pointer" data-bs-toggle="dropdown" style="cursor:pointer">
                        <div class="text-end me-3 d-none d-md-block">
                            <div class="fw-bold text-dark lh-1">@currentUserName</div>
                            <div class="small text-muted">@userRole | ID: @userId</div>
                        </div>
                        <i class="bi bi-person-circle fs-2 text-primary"></i>
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                        <li>
                            <a class="dropdown-item text-danger fw-bold py-2" asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-left me-2"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <button class="btn btn-primary fw-bold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#authModal">
                    Đăng nhập / Đăng ký
                </button>
            }
        </div>
    </header>

    <div class="app-wrapper">
        <nav id="sidebar" class="bg-white border-end shadow-sm d-flex flex-column" style="height: calc(100vh - 70px); overflow-y: auto;">
            
            <ul class="nav nav-pills flex-column px-2 py-3 gap-2 mb-auto">
                <li class="nav-item">
                    <a asp-controller="Home" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2">
                        <i class="bi bi-house-door fs-5"></i>
                        <span class="sidebar-text ms-3 fw-bold">Trang chủ</span>
                    </a>
                </li>

                @if (userRole == "Admin")
                {
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-danger">
                            <i class="bi bi-speedometer2 fs-5"></i>
                            <span class="sidebar-text ms-3 fw-bold">Hệ thống</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="ManageUsers" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2">
                            <i class="bi bi-people-fill fs-5"></i>
                            <span class="sidebar-text ms-3 fw-bold">Người dùng</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Classroom" asp-action="Request" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="sidebar-text ms-3 fw-bold">Thông báo</span>
                        </a>
                    </li>
                }
                else if (userRole == "User")
                {
                    <li class="nav-item">
                        <a asp-controller="StudySet" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2">
                            <i class="bi bi-card-heading fs-5"></i>
                            <span class="sidebar-text ms-3 fw-bold">Học phần của tôi</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Classroom" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2">
                            <i class="bi bi-people fs-5"></i>
                            <span class="sidebar-text ms-3 fw-bold">Lớp học</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Classroom" asp-action="YourClass" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2">
                            <i class="bi bi-backpack fs-5"></i>
                            <span class="sidebar-text ms-3 fw-bold">Lớp học của bạn</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Classroom" asp-action="Request" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="sidebar-text ms-3 fw-bold">Thông báo</span>
                        </a>
                    </li>
                }
            </ul>

            @if (isLoggedIn)
            {
                <div class="sidebar-bottom p-3 border-top bg-white mt-auto w-100">
                    <ul class="nav nav-pills flex-column gap-1">
                        <li class="nav-item">
                            <a href="#settingsCollapseMenu" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="settingsCollapseMenu" class="nav-link sidebar-link d-flex align-items-center justify-content-between rounded-3 px-3 py-2 text-dark text-decoration-none" id="btn-settings-toggle">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-gear fs-5"></i>
                                    <span class="sidebar-text ms-3 fw-bold">Cài đặt</span>
                                </div>
                                <i class="bi bi-chevron-down small chevron-icon" style="transition: transform 0.3s ease;"></i>
                            </a>
                            
                            <div class="collapse mt-1" id="settingsCollapseMenu">
                                <ul class="nav flex-column ms-3 ps-2 border-start border-2 border-primary border-opacity-25 gap-1 pt-1">
                                    
                                    <li class="nav-item">
                                        <a asp-controller="User" asp-action="Profile" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-dark sub-menu-link">
                                            <i class="bi bi-person-vcard fs-6 text-primary"></i>
                                            <span class="sidebar-text ms-2 fw-semibold" style="font-size: 0.95rem;">Tài khoản</span>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a href="#" id="theme-toggle-btn" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-dark sub-menu-link">
                                            <i class="bi bi-moon-stars-fill fs-6 text-secondary" id="theme-icon"></i>
                                            <span class="sidebar-text ms-2 fw-semibold" style="font-size: 0.95rem;" id="theme-text">Giao diện tối</span>
                                        </a>
                                    </li>

                                    <li class="nav-item">
                                        <a href="#" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-dark sub-menu-link">
                                            <i class="bi bi-globe fs-6 text-info"></i>
                                            <span class="sidebar-text ms-2 fw-semibold" style="font-size: 0.95rem;">Ngôn ngữ</span>
                                        </a>
                                    </li>

                                    <li class="nav-item mt-2">
                                        <a asp-controller="Auth" asp-action="Logout" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-danger sub-menu-link">
                                            <i class="bi bi-box-arrow-left fs-6"></i>
                                            <span class="sidebar-text ms-2 fw-semibold" style="font-size: 0.95rem;">Đăng xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    </ul>
                </div>
            }
        </nav>

        <main id="main-content" class="p-4 p-md-5">
            <div class="container-fluid" style="max-width: 1200px;">
                @RenderBody()
            </div>
        </main>
    </div>

    <partial name="_AuthModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
            document.addEventListener("DOMContentLoaded", function () {
            
                // ==========================================
                // 1. ĐIỀU KHIỂN SIDEBAR (GIỮ NGUYÊN)
                // ==========================================
                const btnToggle = document.getElementById('btn-toggle-sidebar');
                if (btnToggle) {
                    btnToggle.addEventListener('click', function (e) {
                        e.preventDefault();
                        document.documentElement.classList.toggle('sidebar-expanded-state');
                    
                        const isExpanded = document.documentElement.classList.contains('sidebar-expanded-state');
                        localStorage.setItem('quiz_study_sidebar_state', isExpanded);
                    });
                }

                // ==========================================
                // 2. ĐIỀU KHIỂN GIAO DIỆN SÁNG / TỐI (ĐÃ FIX LỖI)
                // ==========================================
                const themeBtn = document.getElementById('theme-toggle-btn');
                const themeIcon = document.getElementById('theme-icon');
                const themeText = document.getElementById('theme-text');

                // Hàm đồng bộ giao diện hiển thị cho chữ và icon nút bấm
                function syncThemeUI(isDark) {
                    if(themeIcon) themeIcon.className = isDark ? 'bi bi-sun-fill fs-6 text-warning' : 'bi bi-moon-stars-fill fs-6 text-secondary';
                    if(themeText) themeText.innerText = isDark ? 'Giao diện sáng' : 'Giao diện tối';
                }

               // Chỉ cần đồng bộ Icon và Text nút bấm thôi, phần màu nền đã được xử lý trên cùng
            const isCurrentlyDark = document.documentElement.classList.contains('dark-theme');
            syncThemeUI(isCurrentlyDark);

                // Bắt sự kiện Click chuyển đổi thủ công
                if (themeBtn) {
                    themeBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                    
                        document.documentElement.classList.toggle('dark-theme');
                        document.body.classList.toggle('dark-theme');
                    
                        const nowDark = document.documentElement.classList.contains('dark-theme');
                        syncThemeUI(nowDark);
                        localStorage.setItem('quiz_study_theme', nowDark ? 'dark' : 'light');
                    });
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <environment include="Development">
        <div id="agentation-mount"></div>
        <script type="module">
            // Import React và Agentation trực tiếp từ CDN mà không cần cài đặt Node.js hay Webpack
            import React from 'https://esm.sh/react@18.3.1';
            import { createRoot } from 'https://esm.sh/react-dom@18.3.1/client';
            import { Agentation } from 'https://esm.sh/agentation?deps=react@18.3.1,react-dom@18.3.1';

            const mountNode = document.getElementById('agentation-mount');
            if (mountNode) {
            const root = createRoot(mountNode);
            root.render(React.createElement(Agentation));
            }
        </script>
    </environment>
</body>
</html>