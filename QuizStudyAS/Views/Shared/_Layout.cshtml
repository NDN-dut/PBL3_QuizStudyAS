                var currentCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
                var currentAct = (ViewContext.RouteData.Values["action"]?.ToString() ?? "index").ToLower();

                // Hàm 1: Dành cho các mục thông thường
                string GetActive(string c, string a = "")
                {
                    if (currentCtrl != c.ToLower()) return "text-muted";
                    if (string.IsNullOrEmpty(a)) return "active";
                    return currentAct == a.ToLower() ? "active" : "text-muted";
                }

                // Hàm 2: Dành ĐẶC BIỆT cho Lớp học
                // Mục Lớp học sẽ sáng lên ở mọi Action (Index, Detail, Share...) NGOẠI TRỪ trang Request (Thông báo)
                // string GetClassroomActive()
                // {
                    // Sửa "request" thành "joinrequests"
                //     return (currentCtrl == "classroom" && currentAct != "joinrequests") ? "active-sidebar-item" : "text-muted";
                // }
            }

            <ul class="nav nav-pills flex-column px-2 py-3 gap-2 mb-auto">
                <li class="nav-item">
