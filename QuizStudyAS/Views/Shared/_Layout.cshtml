                        <i class="bi bi-house-door fs-5 menu-icon"></i>
                        <span class="sidebar-text ms-3 fw-bold">Trang chủ</span>
                    </a>
                </li>

                @* --- QUYỀN DÀNH RIÊNG CHO ADMIN --- *@
                @if (userRole == "Admin")
                {
                    <hr class="my-1 text-secondary opacity-25" />

                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Admin", "Dashboard")">
                            <i class="bi bi-speedometer2 fs-5 text-danger menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Hệ thống</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="ManageUsers" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Admin", "ManageUsers")">
                            <i class="bi bi-people-fill fs-5 text-secondary menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Người dùng</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        @*<a asp-controller="Classroom" asp-action="JoinRequests" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Classroom", "JoinRequests")">
                            <i class="bi bi-bell fs-5 text-info menu-icon position-relative">
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger request-badge-count" style="font-size: 0.55rem; padding: 0.35em 0.5em; display: none; transition: all 0.3s ease;">0</span>
                              </i>
                        </a>*@
                        <a asp-controller="Admin" asp-action="ManageClassrooms" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Admin", "ManageClassrooms")">
                            <i class="bi bi-easel-fill fs-5 text-success menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Quản lý lớp học</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Admin" asp-action="ManageStudySets" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Admin", "ManageStudySets")">
                            <i class="bi bi-journal-text fs-5 text-warning menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Quản lý học phần</span>
                        </a>
                    </li>

                    @* <li class="nav-item">
                        <a asp-controller="Classroom" asp-action="JoinRequests" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Classroom", "JoinRequests")">
                            <i class="bi bi-bell fs-5 text-info menu-icon"></i>

                            <span class="sidebar-text ms-3 fw-bold">Thông báo</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Leaderboard" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Leaderboard")">
                            <i class="bi bi-trophy-fill fs-5 text-secondary menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Bảng xếp hạng</span>
                        </a>
                    </li> *@
                }
                @* --- QUYỀN DÀNH CHO USER --- *@
                @if (userRole == "User" || userRole == "Admin")
                {
                    <hr class="my-1 text-secondary opacity-25" />

                    <li class="nav-item">
                        <a asp-controller="StudySet" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("StudySet")">
                            <i class="bi bi-card-heading fs-5 text-success menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Học phần của tôi</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Classroom" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Classroom", "Index")">
                            <i class="bi bi-people fs-5 text-secondary menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Lớp học</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Exam" asp-action="MyExams" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Exam", "MyExams")">
                            <i class="bi bi-clipboard-check fs-5 text-secondary menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold w-100 d-flex justify-content-between align-items-center">
                                Nhiệm vụ
                                <span id="exam-badge" class="badge bg-danger rounded-pill shadow-sm" style="display: none;">0</span>
                            </span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Classroom" asp-action="JoinRequests" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Classroom", "JoinRequests")">
                            <i class="bi bi-bell fs-5 text-info menu-icon position-relative">
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger request-badge-count" style="font-size: 0.55rem; padding: 0.35em 0.5em; display: none; transition: all 0.3s ease;">0</span>
                            </i>
                            <span class="sidebar-text ms-3 fw-bold">Thông báo</span>
                        </a>
                    </li>
                    <li class="nav-item bg-white">
                        <a asp-controller="Leaderboard" asp-action="Index" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 @GetActive("Leaderboard")">
                            <i class="bi bi-trophy-fill fs-5 text-warning menu-icon"></i>
                            <span class="sidebar-text ms-3 fw-bold">Bảng xếp hạng</span>
                        </a>
                    </li>
                }
            </ul>

    <div class="sidebar-bottom p-3 border-top bg-white mt-auto w-100">
        <ul class="nav nav-pills flex-column gap-1">
            <li class="nav-item">
                <a href="#settingsCollapseMenu" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="settingsCollapseMenu" class="nav-link sidebar-link d-flex align-items-center justify-content-between rounded-3 px-3 py-2 text-dark text-decoration-none" id="btn-settings-toggle">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-gear fs-5"></i>
                        <span class="sidebar-text ms-3 fw-bold">Cài đặt</span>
                    </div>
                    <i class="bi bi-chevron-down small chevron-icon" style="transition: transform 0.3s ease;"></i>
                </a>

                <div class="collapse mt-1" id="settingsCollapseMenu">
                    <ul class="nav flex-column ms-3 ps-2 border-start border-2 border-primary border-opacity-25 gap-1 pt-1">

                        @if (isLoggedIn)
                        {
                            <li class="nav-item ">
                                <a asp-controller="User" asp-action="Profile" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-dark sub-menu-link">
                                    <i class="bi bi-person-vcard fs-6 text-primary"></i>
                                    <span class="sidebar-text ms-2 fw-semibold" style="font-size: 0.95rem;">Tài khoản</span>
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a href="#" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-dark sub-menu-link theme-toggle-btn">
                                <i class="bi bi-moon-stars-fill fs-6 text-secondary theme-icon"></i>
                                <span class="sidebar-text ms-2 fw-semibold theme-text" style="font-size: 0.95rem;">Giao diện tối</span>
                            </a>
                        </li>

                        <li class="nav-item ">
                            <a href="#" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-dark sub-menu-link">
                                <i class="bi bi-globe fs-6 text-info"></i>
                                <span class="sidebar-text ms-2 fw-semibold" style="font-size: 0.95rem;">Ngôn ngữ</span>
                            </a>
                        </li>

                        @if (isLoggedIn)
                        {
                            <li class="nav-item mt-2">
                                <a asp-controller="Auth" asp-action="Logout" class="nav-link sidebar-link d-flex align-items-center rounded-3 px-3 py-2 text-danger sub-menu-link">
                                    <i class="bi bi-box-arrow-left fs-6"></i>
                                    <span class="sidebar-text ms-2 fw-semibold" style="font-size: 0.95rem;">Đăng xuất</span>
                                </a>
                            </li>
                        }
                        else
                        {
