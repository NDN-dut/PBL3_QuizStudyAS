<div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header pb-0 border-bottom-0">
                <ul class="nav nav-tabs w-100" id="authTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold" id="login-tab" data-bs-toggle="tab" data-bs-target="#login-panel" type="button" role="tab">Đăng Nhập</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold" id="register-tab" data-bs-toggle="tab" data-bs-target="#register-panel" type="button" role="tab">Đăng Ký</button>
                    </li>
                </ul>
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-4">
                <div class="tab-content" id="authTabContent">

                    <div class="tab-pane fade show active" id="login-panel" role="tabpanel">

                        <div class="ghost-wrapper mb-4 mt-2">
                            <div class="ghost-container" id="login-mascot">
                                <div class="ghost-body">
                                    <div class="ghost-face">
                                        <div class="eye left"></div>
                                        <div class="eye right"></div>
                                        <div class="mouth"></div>
                                        <div class="cheek left"></div>
                                        <div class="cheek right"></div>
                                    </div>
                                    <div class="arm left"></div>
                                    <div class="arm right"></div>
                                    <div class="ghost-skirt">
                                        <div class="bump"></div>
                                        <div class="bump"></div>
                                        <div class="bump"></div>
                                    </div>
                                </div>
                                <div class="ghost-shadow"></div>
                            </div>
                        </div>

                        <div id="loginAlert" class="alert alert-danger d-none" role="alert"></div>

                        <form id="loginForm" asp-controller="Auth" asp-action="Login" method="post">
                            <div class="mb-3">
                                <label class="form-label">Tài khoản hoặc Email</label>
                                <input type="text" name="UserNameOrEmail" class="form-control" required placeholder="Nhập tên hoặc email..." />
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Mật khẩu</label>
                                <div class="input-group">
                                    <input type="password" id="password-input" name="Password" class="form-control border-end-0" required placeholder="Nhập mật khẩu..." />
                                    <button class="btn btn-outline-secondary border-start-0" style="border-color: #dee2e6;" type="button" id="btn-toggle-password">
                                        <i class="bi bi-eye-slash text-muted" id="eye-icon"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="text-end mt-2 mb-3">
                                <a asp-controller="Auth" asp-action="ForgotPassword" class="text-decoration-none small fw-bold text-primary">
                                    Quên mật khẩu?
                                </a>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 fw-bold">Đăng Nhập</button>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="register-panel" role="tabpanel">
                        <div id="registerAlert" class="alert d-none" role="alert"></div>

                        <form id="registerForm" asp-controller="Auth" asp-action="Register" method="post">
                            <div class="mb-3">
                                <label class="form-label">Tên tài khoản</label>
                                <input type="text" name="UserName" class="form-control" required placeholder="Nhập tên hiển thị..." />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Địa chỉ Email</label>
                                <input type="email" name="Email" class="form-control" required placeholder="name@example.com" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mật khẩu</label>
                                <input type="password" name="Password" class="form-control" required placeholder="Tạo mật khẩu..." />
                            </div>
                            <div class="mb-4">
                                <label class="form-label">Xác nhận mật khẩu</label>
                                <input type="password" name="ConfirmPassword" class="form-control" required placeholder="Nhập lại mật khẩu..." />
                            </div>
                            <button type="submit" class="btn btn-success w-100 fw-bold">Tạo Tài Khoản</button>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Biến màu theo giao diện */
    :root {
        --ghost-color: #a8d5ff; /* Xanh pastel cute cho sáng */
        --ghost-shadow: rgba(168, 213, 255, 0.4);
    }

    /* Tự động đổi màu Trắng khi bật Dark Mode (Theo file theme.css của bạn) */
    body.dark-theme {
        --ghost-color: #f1f1f1;
        --ghost-shadow: rgba(255, 255, 255, 0.15);
    }

    /* Khung chứa & Bay bồng bềnh */
    .ghost-wrapper {
        height: 160px;
        display: flex;
        justify-content: center;
        align-items: flex-end;
    }

    .ghost-container {
        position: relative;
        width: 110px;
        height: 120px;
        animation: float-ghost 3s ease-in-out infinite;
    }

    /* Thân hình */
    .ghost-body {
        position: relative;
        width: 100%;
        height: 100px;
        background-color: var(--ghost-color);
        border-radius: 55px 55px 10px 10px;
        transition: background-color 0.4s ease;
        z-index: 2;
    }

    /* Vạt áo */
    .ghost-skirt {
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 100%;
        display: flex;
        justify-content: space-between;
    }

    .bump {
        width: 34%;
        height: 20px;
        background-color: var(--ghost-color);
        border-radius: 0 0 50px 50px;
        transition: background-color 0.4s ease;
    }

    /* Mặt */
    .ghost-face {
        position: absolute;
        top: 35px;
        left: 0;
        width: 100%;
        height: 50px;
    }

    /* ==========================================
           1. CẬP NHẬT ĐÔI MẮT ĐỂ CÓ THỂ DI CHUYỂN
           ========================================== */
    .eye {
        position: absolute;
        width: 12px;
        height: 12px;
        background: #2b2b2b;
        border-radius: 50%;
        /* Nhận tọa độ X, Y từ JavaScript để liếc mắt */
        transform: translate(var(--eye-x, 0px), var(--eye-y, 0px));
        transition: transform 0.15s ease-out; /* Tốc độ liếc mắt mượt mà */
    }

        .eye.left {
            left: 28px;
        }

        .eye.right {
            right: 28px;
        }

    .cheek {
        position: absolute;
        width: 14px;
        height: 6px;
        background: #ff8a80;
        border-radius: 50%;
        top: 25px;
        opacity: 0.8;
    }

        .cheek.left {
            left: 16px;
        }

        .cheek.right {
            right: 16px;
        }

    .mouth {
        position: absolute;
        width: 16px;
        height: 8px;
        border: 3px solid #2b2b2b;
        border-top: none;
        border-radius: 0 0 20px 20px;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        transition: all 0.2s ease;
    }

    /* Tay */
    .arm {
        position: absolute;
        width: 28px;
        height: 35px;
        background-color: var(--ghost-color);
        border-radius: 30px;
        top: 55px;
        z-index: 3;
        /* Bổ sung: Đổi tâm xoay về giữa để tay vươn ra từ 2 mép */
        transform-origin: center;
        transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55), background-color 0.4s ease, width 0.4s ease, height 0.4s ease;
    }

        .arm.left {
            left: -10px;
            transform: rotate(-35deg);
        }

        .arm.right {
            right: -10px;
            transform: rotate(35deg);
        }

    /* ==========================================
           2. CẬP NHẬT TAY CHE MẮT NHƯNG CHỪA LẠI MIỆNG
           ========================================== */
    .ghost-container.scared .arm {
        /* Tăng độ mập (height) lên 28px để che bít bùng chiều dọc của mắt */
        /* Chiều dài (width) 38px là điểm vàng để không đụng nhau ở giữa */
        width: 38px;
        height: 28px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3); /* Tăng nhẹ độ đậm của bóng đổ */
        /* CHỈNH ĐẬM HƠN Ở ĐÂY */
        filter: brightness(0.80); /* Giảm từ 0.92 xuống 0.80 để tay tối đi 20% */
    }

        .ghost-container.scared .arm.left {
            /* Đẩy vào 18px và đưa lên -24px, vặn góc 15 độ để tay ôm trọn tròng đen */
            transform: translate(18px, -24px) rotate(15deg);
        }

        .ghost-container.scared .arm.right {
            transform: translate(-18px, -24px) rotate(-15deg);
        }

    .ghost-container.scared .mouth {
        /* Miệng chữ O hốt hoảng nằm chễm chệ ngay khe hở giữa 2 bàn tay */
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: none;
        background-color: #2b2b2b;
        top: 12px;
    }

    /* Bóng đổ */
    .ghost-shadow {
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 10px;
        background-color: var(--ghost-shadow);
        border-radius: 50%;
        animation: shadow-scale 3s ease-in-out infinite;
        transition: background-color 0.4s ease;
    }

    /* Keyframes */
    @@keyframes float-ghost {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }
    @@keyframes shadow-scale {
        0%, 100% {
            transform: translateX(-50%) scale(1);
            opacity: 0.6;
        }

        50% {
            transform: translateX(-50%) scale(0.7);
            opacity: 0.2;
        }
    }

    /* Fix ô input group cho Modal */
    .input-group:focus-within {
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        border-radius: 0.375rem;
    }

        .input-group:focus-within .form-control, .input-group:focus-within .btn {
            border-color: #86b7fe !important;
        }

    body.dark-theme .input-group:focus-within .form-control, body.dark-theme .input-group:focus-within .btn {
        border-color: #6ea8fe !important;
        box-shadow: 0 0 0 0.25rem rgba(110, 168, 254, 0.25);
    }

    body.dark-theme .input-group .btn {
        border-color: #444 !important;
    }
    /* Fix viền darkmode */
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // ==========================================
        // 1. LOGIC ẨN/HIỆN MẬT KHẨU & BÉ MA CHE MẮT
        // ==========================================
        const passwordInput = document.getElementById('password-input');
        const btnToggle = document.getElementById('btn-toggle-password');
        const eyeIcon = document.getElementById('eye-icon');
        const mascot = document.getElementById('login-mascot');

        if (btnToggle) {
            btnToggle.addEventListener('click', function () {
                const isHidden = passwordInput.type === 'password';

                if (isHidden) {
                    // HIỆN mật khẩu -> Bé ma CHE MẮT
                    passwordInput.type = 'text';
                    eyeIcon.classList.replace('bi-eye-slash', 'bi-eye');
                    mascot.classList.add('scared');
                } else {
                    // ẨN mật khẩu -> Bé ma BỎ TAY XUỐNG
                    passwordInput.type = 'password';
                    eyeIcon.classList.replace('bi-eye', 'bi-eye-slash');
                    mascot.classList.remove('scared');
                }
            });
        }


        // ==========================================
        // HIỆU ỨNG ĐÔI MẮT DÕI THEO CHỮ ĐÁNH VÀO
        // ==========================================
        const emailInput = document.querySelector('input[name="UserNameOrEmail"]');
        const passInput = document.getElementById('password-input');
        const eyes = document.querySelectorAll('.eye');
        const mascotContainer = document.getElementById('login-mascot');

        // Hàm tính toán và liếc mắt
        function trackEyes(e) {
            // Nếu đang hốt hoảng che mắt (nhìn thấy mật khẩu) thì không liếc nữa
            if (mascotContainer.classList.contains('scared')) return;

            const input = e.target;
            const maxLength = 30; // Giới hạn số lượng ký tự để mắt liếc tối đa
            const length = Math.min(input.value.length, maxLength);

            // Tính toán trục X: Ký tự càng dài, mắt càng liếc sang phải (Từ -5px đến +5px)
            const xPos = (length / maxLength) * 10 - 5;

            // Trục Y: Mắt nhìn cúi xuống (+4px) vì ô nhập liệu nằm ở bên dưới bé ma
            const yPos = 4;

            // Cập nhật tọa độ cho cả 2 mắt
            eyes.forEach(eye => {
                eye.style.setProperty('--eye-x', `${xPos}px`);
                eye.style.setProperty('--eye-y', `${yPos}px`);
            });
        }

        // Hàm reset mắt về chính giữa khi click ra ngoài
        function resetEyes() {
            eyes.forEach(eye => {
                eye.style.setProperty('--eye-x', `0px`);
                eye.style.setProperty('--eye-y', `0px`);
            });
        }

        // Gắn sự kiện cho ô Tên đăng nhập / Email
        if (emailInput) {
            emailInput.addEventListener('focus', trackEyes); // Vừa click vào là nhìn xuống
            emailInput.addEventListener('input', trackEyes); // Đánh chữ đến đâu liếc đến đó
            emailInput.addEventListener('blur', resetEyes);  // Click ra ngoài là nhìn thẳng lại
        }

        // Gắn sự kiện cho ô Mật khẩu
        if (passInput) {
            passInput.addEventListener('focus', trackEyes);
            passInput.addEventListener('input', trackEyes);
            passInput.addEventListener('blur', resetEyes);
        }


        // ==========================================
        // 2. LOGIC SUBMIT FORM BẰNG AJAX (Cũ của bạn)
        // ==========================================
        async function submitFormAJAX(formId, alertId, isLogin) {
            const form = document.getElementById(formId);
            const alertBox = document.getElementById(alertId);

            if (!form) return; // Fix lỗi nếu không tìm thấy form

            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const formData = new FormData(form);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();

                    if (data.success) {
                        if (isLogin) {
                            window.location.reload();
                        } else {
                            alertBox.className = "alert alert-success";
                            alertBox.textContent = data.message;
                            alertBox.classList.remove("d-none");
                            form.reset();
                        }
                    } else {
                        alertBox.className = "alert alert-danger";
                        alertBox.textContent = data.message;
                        alertBox.classList.remove("d-none");
                    }
                } catch (error) {
                    alertBox.className = "alert alert-danger";
                    alertBox.textContent = "Có lỗi xảy ra khi kết nối đến máy chủ.";
                    alertBox.classList.remove("d-none");
                }
            });
        }

        submitFormAJAX("loginForm", "loginAlert", true);
        submitFormAJAX("registerForm", "registerAlert", false);

    });
</script>